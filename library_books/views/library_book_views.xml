<odoo>

    <!-- 1. Define the model itself -->
    <record id="model_x_library_book" model="ir.model">
        <field name="name">Library Book</field>
        <field name="model">x_library.book</field>
    </record>

    <!-- 2. Define fields on it -->
    <record id="field_x_library_book_title" model="ir.model.fields">
        <field name="name">x_title</field>
        <field name="field_description">Title</field>
        <field name="model_id" ref="model_x_library_book"/>
        <field name="model">x_library.book</field>
        <field name="ttype">char</field>
    </record>

    <record id="field_x_library_book_author" model="ir.model.fields">
        <field name="name">x_author</field>
        <field name="field_description">Author</field>
        <field name="model_id" ref="model_x_library_book"/>
        <field name="model">x_library.book</field>
        <field name="ttype">char</field>
    </record>

    <record id="field_x_library_book_available" model="ir.model.fields">
        <field name="name">x_available</field>
        <field name="field_description">Available</field>
        <field name="model_id" ref="model_x_library_book"/>
        <field name="model">x_library.book</field>
        <field name="ttype">boolean</field>
    </record>

    <!-- 3. Form view -->
    <record id="view_x_library_book_form" model="ir.ui.view">
        <field name="name">x_library.book.form</field>
        <field name="model">x_library.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="x_title"/>
                        <field name="x_author"/>
                        <field name="x_available"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 4. List view -->
    <record id="view_x_library_book_list" model="ir.ui.view">
        <field name="name">x_library.book.list</field>
        <field name="model">x_library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_title"/>
                <field name="x_author"/>
                <field name="x_available"/>
            </list>
        </field>
    </record>

    <!-- 5. Window action (connects menu to views) -->
    <record id="action_x_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">x_library.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 6. Menu -->
    <menuitem id="menu_x_library_root" name="Library" sequence="90"
              web_icon="library_books,static/description/icon.png"/>
    <menuitem id="menu_x_library_book" name="Books"
              parent="menu_x_library_root"
              action="action_x_library_book" sequence="10"/>

</odoo>