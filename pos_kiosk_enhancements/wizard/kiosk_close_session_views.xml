<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kiosk_close_session_form" model="ir.ui.view">
        <field name="name">kiosk.close.session.form</field>
        <field name="model">kiosk.close.session</field>
        <field name="arch" type="xml">
            <form string="Close Kiosk Session">
                <sheet>
                    <div class="alert alert-warning">
                        <strong>
                            There are unpaid kiosk orders.
                        </strong>
                    </div>
                    <group>
                        <field name="draft_order_count" readonly="1"/>
                    </group>
                        <field name="draft_order_ids"
                               nolabel="1"
                               readonly="1">
                            <tree create="0"
                                  delete="0"
                                  edit="0">
                                <field name="tracking_number"/>
                                <field name="pos_reference"/>
                                <field name="amount_total"/>
                                <field name="date_order"/>
                                <field name="state"/>
                            </tree>
                        </field>
                </sheet>
                <footer>
                    <button
                            name="action_cancel_orders_and_close"
                            type="object"
                            string="Cancel Draft Orders &amp; Close Session"
                            class="btn-primary"/>
                    <button
                            name="action_close_only"
                            type="object"
                            string="Close Session Only"
                            class="btn-secondary"/>
                    <button
                            string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>