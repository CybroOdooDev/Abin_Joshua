<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pos_order_cancel_view_form" model="ir.ui.view">
        <field name="name">pos.order.cancel.view.form</field>
        <field name="model">pos.order.cancel</field>
        <field name="arch" type="xml">
            <form string="Cancel Orders">
                <field name="order_ids" readonly="1">
                    <tree>
                        <field name="tracking_number"/>
                        <field name="pos_reference"/>
                        <field name="amount_total"/>
                        <field name="state"/>
                    </tree>
                </field>

                <footer>
                    <button
                        name="action_confirm_cancel"
                        type="object"
                        string="Cancel Orders"
                        class="btn-primary"/>

                    <button
                        string="Close"
                        special="cancel"/>
                </footer>

            </form>
        </field>
    </record>
</odoo>