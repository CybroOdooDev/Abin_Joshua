<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_customer_logo" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@name='address_not_same_as_shipping']//address" position="before">
            <t t-set="partner_logo" t-value="o.partner_id.commercial_partner_id.image_1920 or o.partner_id.image_1920"/>
            <div t-if="partner_logo" class="mb-2 customer-logo">
                <img t-att-src="image_data_uri(partner_logo)" style="max-height: 60px; max-width: 160px; object-fit: contain;" alt="Customer Logo"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='address_same_as_shipping']//address" position="before">
            <t t-set="partner_logo" t-value="o.partner_id.commercial_partner_id.image_1920 or o.partner_id.image_1920"/>
            <div t-if="partner_logo" class="mb-2 customer-logo">
                <img t-att-src="image_data_uri(partner_logo)" style="max-height: 60px; max-width: 160px; object-fit: contain;" alt="Customer Logo"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='no_shipping']//address" position="before">
            <t t-set="partner_logo" t-value="o.partner_id.commercial_partner_id.image_1920 or o.partner_id.image_1920"/>
            <div t-if="partner_logo" class="mb-2 customer-logo">
                <img t-att-src="image_data_uri(partner_logo)" style="max-height: 60px; max-width: 160px; object-fit: contain;" alt="Customer Logo"/>
            </div>
        </xpath>
    </template>
</odoo>
