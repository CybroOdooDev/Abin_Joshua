<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pos_order_form_inherit_cancel" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.cancel</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_cancel_order"
                        string="Cancel Order"
                        type="object"
                        class="btn-danger"
                        invisible="state in ['paid','cancel']"/>
            </xpath>
        </field>
    </record>
    <record id="action_pos_order_cancel_selected" model="ir.actions.server">
        <field name="name">Cancel Selected Orders</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="binding_model_id" ref="point_of_sale.model_pos_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_open_cancel_wizard()
        </field>
    </record>
</odoo>
