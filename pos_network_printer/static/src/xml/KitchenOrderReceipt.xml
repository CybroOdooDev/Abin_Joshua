<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_network_printer.KitchenOrderReceipt">
        <t t-set="d" t-value="typeof props !== 'undefined' and props.data ? props.data : data"/>
        <div class="pos-receipt pos-kitchen-receipt" style="width: 330px; font-family: monospace; font-size: 15px; color: #000; padding: 10px 15px; background: #fff; box-sizing: border-box; margin: 0 auto;">
            <!-- HEADER -->
            <div style="text-align: center; border-bottom: 2px dashed #000; padding-bottom: 8px; margin-bottom: 8px;">
                <div style="font-size: 22px; font-weight: bold; letter-spacing: 2px;">*** COCINA / KITCHEN ***</div>
                <div style="font-size: 18px; font-weight: bold; margin-top: 4px;">
                    <t t-if="d.tableName">
                        MESA: <t t-esc="d.tableName"/>
                        <t t-if="d.floorName"> (<t t-esc="d.floorName"/>)</t>
                    </t>
                    <t t-else="">
                        <t t-esc="d.orderType || 'PARA LLEVAR / TAKEAWAY'"/>
                    </t>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 14px; margin-top: 6px;">
                    <span>ORDEN: #<t t-esc="d.orderName"/></span>
                    <span>HORA: <t t-esc="d.time"/></span>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 13px; margin-top: 2px; color: #222;">
                    <span>CAMARERO: <t t-esc="d.cashierName"/></span>
                    <t t-if="d.diners">
                        <span>COMENSALES: <t t-esc="d.diners"/></span>
                    </t>
                </div>
            </div>

            <!-- CANCELLED ITEMS (IF ANY) -->
            <t t-if="d.cancelledLines and d.cancelledLines.length > 0">
                <div style="border: 2px solid #000; padding: 6px; margin-bottom: 10px; background-color: #f2f2f2;">
                    <div style="font-size: 16px; font-weight: bold; text-align: center; text-decoration: underline;">
                        *** ANULADO / CANCELLED ***
                    </div>
                    <t t-foreach="d.cancelledLines" t-as="item" t-key="item_index">
                        <div style="display: flex; justify-content: space-between; font-size: 15px; font-weight: bold; margin-top: 4px;">
                            <span>-<t t-esc="item.qty"/>x <t t-esc="item.name"/></span>
                        </div>
                        <t t-if="item.note">
                            <div style="font-size: 13px; margin-left: 15px;">* <t t-esc="item.note"/></div>
                        </t>
                    </t>
                </div>
            </t>

            <!-- COURSES / PLATING LEVELS -->
            <t t-foreach="d.courses" t-as="course" t-key="course.id || course_index">
                <div style="margin-bottom: 12px;">
                    <!-- Course Header -->
                    <div style="background-color: #000; color: #fff; padding: 4px 8px; font-size: 16px; font-weight: bold; text-transform: uppercase; margin-bottom: 6px; letter-spacing: 1px;">
                        [ <t t-esc="course.name"/> ]
                    </div>

                    <!-- Items inside this course -->
                    <t t-foreach="course.lines" t-as="line" t-key="line_index">
                        <div style="margin-bottom: 6px; padding-bottom: 4px; border-bottom: 1px dotted #ccc;">
                            <div style="display: flex; align-items: baseline; justify-content: space-between;">
                                <span style="font-size: 18px; font-weight: 900; width: 45px;"><t t-esc="line.qty"/>x</span>
                                <span style="font-size: 16px; font-weight: bold; flex: 1; text-align: left;"><t t-esc="line.name"/></span>
                            </div>

                            <!-- Combo child lines -->
                            <t t-if="line.comboLines and line.comboLines.length > 0">
                                <t t-foreach="line.comboLines" t-as="comboItem" t-key="comboItem_index">
                                    <div style="margin-left: 25px; font-size: 14px; color: #222;">
                                        + <t t-if="comboItem.qty and comboItem.qty > 1"><t t-esc="comboItem.qty"/>x </t><t t-esc="comboItem.name"/>
                                        <t t-if="comboItem.note">
                                            <span style="font-weight: bold;"> (<t t-esc="comboItem.note"/>)</span>
                                        </t>
                                    </div>
                                </t>
                            </t>

                            <!-- Customer Notes / Instructions -->
                            <t t-if="line.note">
                                <div style="margin-left: 20px; font-size: 14px; font-weight: bold; background: #eee; padding: 2px 4px; margin-top: 2px; border-left: 3px solid #000;">
                                    * NOTA: <t t-esc="line.note"/>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </t>

            <!-- FOOTER -->
            <div style="border-top: 2px dashed #000; padding-top: 6px; margin-top: 10px; text-align: center; font-size: 13px;">
                <div>ENVIADO A COCINA: <t t-esc="d.date"/> <t t-esc="d.time"/></div>
                <div style="letter-spacing: 3px; font-weight: bold; margin-top: 4px;">========================</div>
            </div>
        </div>
    </t>
</templates>
