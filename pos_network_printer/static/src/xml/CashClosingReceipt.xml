<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_network_printer.CashClosingReceipt">
        <div class="pos-receipt pos-thermal-receipt text-start" style="width: 330px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; line-height: 1.35; color: #000000; padding: 12px 10px; background: #ffffff; box-sizing: border-box;">
            
            <!-- Company & Header (Table layout: strictly prevents text overlapping) -->
            <table style="width: 100%; border-collapse: collapse; text-align: center; margin-bottom: 6px;">
                <tr>
                    <td style="font-weight: 800; font-size: 16px; text-transform: uppercase; text-align: center; padding: 1px 0;">
                        <t t-esc="props.data.company.name"/>
                    </td>
                </tr>
                <tr t-if="props.data.company.vat">
                    <td style="font-size: 12px; font-weight: bold; text-align: center; padding: 1px 0;">
                        VAT: <t t-esc="props.data.company.vat"/>
                    </td>
                </tr>
                <tr t-if="props.data.company.street">
                    <td style="font-size: 11px; text-align: center; padding: 1px 0;">
                        <t t-esc="props.data.company.street"/>
                    </td>
                </tr>
                <tr t-if="props.data.company.city_zip">
                    <td style="font-size: 11px; text-align: center; padding: 1px 0;">
                        <t t-esc="props.data.company.city_zip"/>
                    </td>
                </tr>
                <tr t-elif="!props.data.company.street and props.data.company.address">
                    <td style="font-size: 11px; text-align: center; padding: 1px 0;">
                        <t t-esc="props.data.company.address"/>
                    </td>
                </tr>
                <tr t-if="props.data.company.phone">
                    <td style="font-size: 11px; text-align: center; padding: 2px 0;">
                        Tel: <t t-esc="props.data.company.phone"/>
                    </td>
                </tr>
            </table>

            <div style="text-align: center; margin: 8px 0; padding: 4px 0; border-top: 2px solid #000; border-bottom: 2px solid #000;">
                <div style="font-weight: 900; font-size: 15px; letter-spacing: 1px; text-transform: uppercase;">*** CASH CLOSING (Z) ***</div>
                <div style="font-size: 11px; font-weight: bold; text-transform: uppercase;">SESSION CLOSING REPORT</div>
            </div>

            <!-- Meta details (Table-based layout: immune to flex wrapping collisions) -->
            <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 6px;">
                <tr>
                    <td style="width: 32%; font-weight: bold; padding: 2px 0; vertical-align: top;">Terminal:</td>
                    <td style="width: 68%; text-align: right; padding: 2px 0; vertical-align: top;" t-esc="props.data.session.pos_name"/>
                </tr>
                <tr>
                    <td style="font-weight: bold; padding: 2px 0; vertical-align: top;">Session:</td>
                    <td style="text-align: right; font-weight: bold; padding: 2px 0; vertical-align: top;" t-esc="props.data.session.name"/>
                </tr>
                <tr>
                    <td style="font-weight: bold; padding: 2px 0; vertical-align: top;">Cashier:</td>
                    <td style="text-align: right; padding: 2px 0; vertical-align: top;" t-esc="props.data.session.cashier"/>
                </tr>
                <tr>
                    <td style="font-weight: bold; padding: 2px 0; vertical-align: top;">Opening:</td>
                    <td style="text-align: right; white-space: nowrap; padding: 2px 0; vertical-align: top;" t-esc="props.data.session.start_at || '-'"/>
                </tr>
                <tr>
                    <td style="font-weight: bold; padding: 2px 0; vertical-align: top;">Closing:</td>
                    <td style="text-align: right; white-space: nowrap; padding: 2px 0; vertical-align: top;" t-esc="props.data.session.stop_at || '-'"/>
                </tr>
            </table>

            <!-- Cash Drawer Balance (CashSecurity Integration) -->
            <div style="border-top: 1px solid #000; padding-top: 4px; margin-bottom: 6px;">
                <div style="font-weight: 800; font-size: 11px; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.5px;">
                    === CASH DRAWER BALANCE ===
                </div>
                <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                    <tr>
                        <td style="padding: 2px 0; vertical-align: top;">Starting Float:</td>
                        <td style="text-align: right; font-weight: bold; white-space: nowrap; padding: 2px 0; vertical-align: top;" t-esc="props.formatCurrency(props.data.cash_details.opening_cash)"/>
                    </tr>
                    <tr>
                        <td style="padding: 2px 0; vertical-align: top;">(+) Cash Sales:</td>
                        <td style="text-align: right; font-weight: bold; white-space: nowrap; padding: 2px 0; vertical-align: top;" t-esc="props.formatCurrency(props.data.cash_details.cash_sales)"/>
                    </tr>
                    <t t-if="props.data.cash_details.cash_in > 0">
                        <tr>
                            <td style="padding: 2px 0; vertical-align: top;">(+) Cash In:</td>
                            <td style="text-align: right; font-weight: bold; white-space: nowrap; padding: 2px 0; vertical-align: top;" t-esc="props.formatCurrency(props.data.cash_details.cash_in)"/>
                        </tr>
                    </t>
                    <t t-if="props.data.cash_details.cash_out > 0">
                        <tr>
                            <td style="padding: 2px 0; vertical-align: top;">(-) Cash Out:</td>
                            <td style="text-align: right; font-weight: bold; white-space: nowrap; padding: 2px 0; vertical-align: top;" t-esc="props.formatCurrency(-props.data.cash_details.cash_out)"/>
                        </tr>
                    </t>
                    <tr style="border-top: 1px dashed #666;">
                        <td style="padding: 3px 0; font-weight: bold; vertical-align: top;">Expected Cash:</td>
                        <td style="text-align: right; font-weight: bold; white-space: nowrap; padding: 3px 0; vertical-align: top;" t-esc="props.formatCurrency(props.data.cash_details.expected_cash)"/>
                    </tr>
                    <tr style="background-color: #f2f2f2;">
                        <td style="padding: 3px 2px; font-weight: 800; vertical-align: top;">Counted Cash (Drawer):</td>
                        <td style="text-align: right; font-weight: 800; white-space: nowrap; padding: 3px 2px; vertical-align: top;" t-esc="props.formatCurrency(props.data.cash_details.counted_cash)"/>
                    </tr>
                    <tr style="border-top: 1px solid #000; border-bottom: 1px solid #000;">
                        <td style="padding: 3px 0; font-weight: bold; vertical-align: top;">Difference:</td>
                        <td style="text-align: right; font-weight: 800; white-space: nowrap; padding: 3px 0; vertical-align: top;" t-att-class="{'text-danger': Math.abs(props.data.cash_details.difference) > 0.01}" t-esc="props.formatCurrency(props.data.cash_details.difference)"/>
                    </tr>
                </table>
            </div>

            <!-- Dynamic Payment Breakdown -->
            <div style="border-top: 1px solid #000; padding-top: 4px; margin-bottom: 6px;">
                <div style="font-weight: 800; font-size: 11px; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.5px;">
                    === SALES BY PAYMENT METHOD ===
                </div>
                <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                    <tr t-foreach="props.data.payment_methods" t-as="pm" t-key="pm.id" style="border-bottom: 1px dotted #888;">
                        <td style="padding: 3px 0; vertical-align: middle;">
                            <div style="font-weight: bold;" t-esc="pm.name"/>
                            <div style="font-size: 10px; color: #555;">
                                <t t-esc="pm.count"/> transactions
                            </div>
                        </td>
                        <td style="text-align: right; font-weight: bold; white-space: nowrap; padding: 3px 0; vertical-align: middle;" t-esc="props.formatCurrency(pm.amount)"/>
                    </tr>
                </table>
            </div>

            <!-- Total Sales Summary -->
            <div style="border-top: 2px solid #000; padding-top: 4px; margin-bottom: 8px;">
                <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                    <tr>
                        <td style="padding: 2px 0; vertical-align: top;">Total Orders / Tickets:</td>
                        <td style="text-align: right; font-weight: bold; padding: 2px 0; vertical-align: top;" t-esc="props.data.sales_summary.total_orders"/>
                    </tr>
                    <tr>
                        <td style="padding: 2px 0; vertical-align: top;">Net Sales (Untaxed):</td>
                        <td style="text-align: right; white-space: nowrap; padding: 2px 0; vertical-align: top;" t-esc="props.formatCurrency(props.data.sales_summary.net_sales)"/>
                    </tr>
                    <tr>
                        <td style="padding: 2px 0; vertical-align: top;">Taxes:</td>
                        <td style="text-align: right; white-space: nowrap; padding: 2px 0; vertical-align: top;" t-esc="props.formatCurrency(props.data.sales_summary.tax_total)"/>
                    </tr>
                    <tr style="border-top: 2px solid #000; border-bottom: 2px solid #000; font-size: 15px;">
                        <td style="padding: 5px 0; font-weight: 900; vertical-align: middle; white-space: nowrap;">TOTAL SALES:</td>
                        <td style="text-align: right; font-weight: 900; white-space: nowrap; padding: 5px 0; vertical-align: middle;" t-esc="props.formatCurrency(props.data.sales_summary.gross_sales)"/>
                    </tr>
                </table>
            </div>

            <!-- Signatures / Footer -->
            <table style="width: 100%; border-collapse: collapse; margin-top: 14px; font-size: 10px;">
                <tr>
                    <td style="width: 44%; text-align: center; vertical-align: top;">
                        <div style="border-top: 1px solid #000; padding-top: 4px; font-weight: bold;">Cashier Signature</div>
                    </td>
                    <td style="width: 12%;"></td>
                    <td style="width: 44%; text-align: center; vertical-align: top;">
                        <div style="border-top: 1px solid #000; padding-top: 4px; font-weight: bold;">Manager Signature</div>
                    </td>
                </tr>
            </table>

            <div style="text-align: center; margin-top: 10px; font-size: 9px; color: #555;">
                Printed on <t t-esc="props.currentDate || ''"/>
            </div>

        </div>
    </t>

</templates>
