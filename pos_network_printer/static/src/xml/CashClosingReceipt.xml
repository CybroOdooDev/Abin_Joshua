<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_network_printer.CashClosingReceipt">
        <div class="pos-receipt pos-thermal-receipt text-start" style="width: 330px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; line-height: 1.3; color: #000000; padding: 10px; background: #ffffff;">
            
            <!-- Company & Header -->
            <div class="pos-receipt-header text-center mb-2">
                <div class="fw-bold fs-5 text-uppercase" t-esc="props.data.company.name"/>
                <div t-if="props.data.company.vat" class="small">
                    <strong>NIF/CIF:</strong> <t t-esc="props.data.company.vat"/>
                </div>
                <div t-if="props.data.company.address" class="small" t-esc="props.data.company.address"/>
                <div t-if="props.data.company.phone" class="small">
                    Tel: <t t-esc="props.data.company.phone"/>
                </div>
            </div>

            <div class="text-center my-2 py-1 border-top border-bottom border-dark border-2">
                <div class="fw-bolder fs-6 text-uppercase" style="letter-spacing: 1px;">*** CIERRE DE CAJA (Z) ***</div>
                <div class="small fw-semibold text-uppercase">INFORME DE CIERRE DE SESIÓN</div>
            </div>

            <!-- Meta details -->
            <div class="pos-receipt-meta small mb-2">
                <div class="d-flex justify-content-between">
                    <span><strong>Terminal / TPV:</strong></span>
                    <span t-esc="props.data.session.pos_name"/>
                </div>
                <div class="d-flex justify-content-between">
                    <span><strong>Sesión:</strong></span>
                    <span t-esc="props.data.session.name"/>
                </div>
                <div class="d-flex justify-content-between">
                    <span><strong>Cajero:</strong></span>
                    <span t-esc="props.data.session.cashier"/>
                </div>
                <div class="d-flex justify-content-between">
                    <span><strong>Apertura:</strong></span>
                    <span t-esc="props.data.session.start_at || '-'"/>
                </div>
                <div class="d-flex justify-content-between">
                    <span><strong>Cierre:</strong></span>
                    <span t-esc="props.data.session.stop_at || '-'"/>
                </div>
            </div>

            <!-- Cash Drawer Balance (CashSecurity Integration) -->
            <div class="border-top border-dark border-1 pt-2 mb-2">
                <div class="fw-bold text-uppercase mb-1" style="font-size: 12px; letter-spacing: 0.5px;">
                    === CUADRE DE CAJÓN ===
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Fondo Inicial (Apertura):</span>
                    <span class="fw-bold" t-esc="props.formatCurrency(props.data.cash_details.opening_cash)"/>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>(+) Ventas Efectivo:</span>
                    <span class="fw-bold" t-esc="props.formatCurrency(props.data.cash_details.cash_sales)"/>
                </div>
                <t t-if="props.data.cash_details.cash_in > 0">
                    <div class="d-flex justify-content-between py-1">
                        <span>(+) Entradas de Efectivo:</span>
                        <span class="fw-bold" t-esc="props.formatCurrency(props.data.cash_details.cash_in)"/>
                    </div>
                </t>
                <t t-if="props.data.cash_details.cash_out > 0">
                    <div class="d-flex justify-content-between py-1">
                        <span>(-) Salidas de Efectivo:</span>
                        <span class="fw-bold" t-esc="props.formatCurrency(-props.data.cash_details.cash_out)"/>
                    </div>
                </t>
                <div class="d-flex justify-content-between py-1 border-top border-secondary border-dashed">
                    <span class="fw-bold">Total Efectivo Teórico:</span>
                    <span class="fw-bold" t-esc="props.formatCurrency(props.data.cash_details.expected_cash)"/>
                </div>
                <div class="d-flex justify-content-between py-1 bg-light">
                    <span class="fw-bolder">Efectivo Real (CashSecurity):</span>
                    <span class="fw-bolder" t-esc="props.formatCurrency(props.data.cash_details.counted_cash)"/>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom border-dark border-1">
                    <span class="fw-bold">Descuadre / Diferencia:</span>
                    <span class="fw-bolder" t-att-class="{'text-danger': Math.abs(props.data.cash_details.difference) > 0.01}" t-esc="props.formatCurrency(props.data.cash_details.difference)"/>
                </div>
            </div>

            <!-- Dynamic Payment Breakdown -->
            <div class="border-top border-dark border-1 pt-2 mb-2">
                <div class="fw-bold text-uppercase mb-1" style="font-size: 12px; letter-spacing: 0.5px;">
                    === VENTAS POR MÉTODO DE PAGO ===
                </div>
                <t t-foreach="props.data.payment_methods" t-as="pm" t-key="pm.id">
                    <div class="d-flex justify-content-between py-1 border-bottom border-1 border-dotted">
                        <div class="d-flex flex-column">
                            <span class="fw-bold" t-esc="pm.name"/>
                            <span class="text-muted small" style="font-size: 10px;">
                                <t t-esc="pm.count"/> transacciones
                            </span>
                        </div>
                        <span class="fw-bold align-self-center" t-esc="props.formatCurrency(pm.amount)"/>
                    </div>
                </t>
            </div>

            <!-- Total Sales Summary -->
            <div class="border-top border-dark border-2 pt-2 mb-2">
                <div class="d-flex justify-content-between py-1">
                    <span>Total Pedidos / Tickets:</span>
                    <span class="fw-bold" t-esc="props.data.sales_summary.total_orders"/>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Base Imponible (Neto):</span>
                    <span t-esc="props.formatCurrency(props.data.sales_summary.net_sales)"/>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Impuestos (IVA):</span>
                    <span t-esc="props.formatCurrency(props.data.sales_summary.tax_total)"/>
                </div>
                <div class="d-flex justify-content-between py-1 fs-5 fw-bolder border-top border-dark border-2 mt-1">
                    <span>TOTAL VENTAS:</span>
                    <span t-esc="props.formatCurrency(props.data.sales_summary.gross_sales)"/>
                </div>
            </div>

            <!-- Signatures / Footer -->
            <div class="pos-receipt-footer text-center mt-3 pt-2 border-top border-dark border-1 small">
                <div class="row mt-2">
                    <div class="col-6 text-center">
                        <div style="height: 35px; border-bottom: 1px solid #000; margin: 0 5px;"></div>
                        <div class="mt-1" style="font-size: 10px;">Firma Cajero</div>
                    </div>
                    <div class="col-6 text-center">
                        <div style="height: 35px; border-bottom: 1px solid #000; margin: 0 5px;"></div>
                        <div class="mt-1" style="font-size: 10px;">Firma Responsable</div>
                    </div>
                </div>
                <div class="mt-3 text-muted" style="font-size: 9px;">
                    Impreso el <t t-esc="props.currentDate || ''"/>
                </div>
            </div>

        </div>
    </t>

</templates>
