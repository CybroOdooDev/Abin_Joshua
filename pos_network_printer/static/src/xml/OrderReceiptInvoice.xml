<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_network_printer.OrderReceiptInvoice" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//ReceiptHeader" position="after">
            <!-- Formal Legal Invoice Header (Factura Completa) -->
            <t t-if="props.data.is_to_invoice and props.data.partner">
                <div class="pos-receipt-invoice-box my-2 text-start" style="font-size: 13px;">
                    <div style="border-top: 1px dashed #000; margin: 4px 0;"></div>
                    <div class="fw-bold mb-1" style="text-decoration: underline;">
                        <t t-esc="props.data.partner.labels ? props.data.partner.labels.header : 'Datos del cliente:'"/>
                    </div>
                    <div><strong><t t-esc="props.data.partner.labels ? props.data.partner.labels.customer : 'Cliente:'"/> </strong><t t-esc="props.data.partner.name"/></div>
                    <div t-if="props.data.partner.vat"><strong><t t-esc="props.data.partner.labels ? props.data.partner.labels.vat : 'NIF:'"/> </strong><t t-esc="props.data.partner.vat"/></div>
                    <div t-if="props.data.partner.phone"><strong><t t-esc="props.data.partner.labels ? props.data.partner.labels.phone : 'Teléfono:'"/> </strong><t t-esc="props.data.partner.phone"/></div>
                    <div t-if="props.data.partner.email"><strong><t t-esc="props.data.partner.labels ? props.data.partner.labels.email : 'Correo electrónico:'"/> </strong><t t-esc="props.data.partner.email"/></div>
                    <div t-if="props.data.partner.address"><strong><t t-esc="props.data.partner.labels ? props.data.partner.labels.address : 'Dirección:'"/> </strong><t t-esc="props.data.partner.address"/></div>
                    <div style="border-top: 1px dashed #000; margin: 4px 0;"></div>
                </div>
            </t>
        </xpath>

        <!-- Only show CHANGE when actual payments have been recorded -->
        <xpath expr="//div[hasclass('receipt-change')]" position="attributes">
            <attribute name="t-if">props.data.paymentlines and props.data.paymentlines.length > 0</attribute>
        </xpath>

        <!-- Mark advance / premature receipts as Pending Payment at the very bottom -->
        <xpath expr="//div[hasclass('pos-receipt')]" position="inside">
            <t t-if="props.data.isBill or (props.data.is_paid === false and (!props.data.paymentlines or props.data.paymentlines.length === 0))">
                <div class="pos-receipt-order-data text-center fw-bolder my-2 py-1 pending-payment-indicator" style="font-size: 15px; border-top: 2px dashed #000; border-bottom: 2px dashed #000; text-transform: uppercase; letter-spacing: 1px; font-weight: 800; text-align: center;">
                    *** <t t-if="props.data.pending_payment_label" t-esc="props.data.pending_payment_label"/><t t-else="">PENDIENTE DE PAGO</t> ***
                </div>
            </t>
        </xpath>
    </t>

</templates>
