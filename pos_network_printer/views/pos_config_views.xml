<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_network_printer" model="ir.ui.view">
        <field name="name">pos.config.view.form.qz_printer</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="network_printing_config" name="network_printing_config">
                    <group string="Local Ticket &amp; Kitchen Printing (QZ Tray - No IoT Box)">
                        <div class="text-muted mb-3" colspan="2">
                            Direct local printing to thermal receipt and kitchen preparation printers via QZ Tray without IoT Box or cloud networking restrictions.
                        </div>
                        <div class="d-flex align-items-center gap-2 mb-3" colspan="2" invisible="not enable_network_printing">
                            <button name="action_find_system_printers"
                                    string="Scan / Discover Available Printers"
                                    type="object"
                                    class="btn btn-secondary btn-sm"
                                    icon="fa-refresh"/>
                            <span class="text-muted small">
                                Scans local OS printers and populates the Receipt and Kitchen printer dropdowns.
                            </span>
                        </div>
                        <group string="Customer Receipt Printer">
                            <field name="enable_network_printing"/>
                            <field name="qz_printer_id"
                                   placeholder="Select or enter receipt printer..."
                                   options="{'no_open': False, 'no_create_edit': False}"
                                   invisible="not enable_network_printing"/>
                            <field name="qz_printer_name" invisible="1"/>
                            <field name="auto_print_on_payment"
                                   invisible="not enable_network_printing"/>
                            <field name="simulation_mode" invisible="0"/>
                        </group>
                        <group string="Kitchen Preparation Printer" invisible="not enable_network_printing">
                            <field name="enable_kitchen_printing"/>
                            <field name="qz_kitchen_printer_id"
                                   placeholder="Select or enter kitchen printer..."
                                   options="{'no_open': False, 'no_create_edit': False}"
                                   invisible="not enable_kitchen_printing"/>
                            <field name="qz_kitchen_printer_name" invisible="1"/>
                        </group>
                        <group string="POS Cash Closing Report">
                            <field name="cash_closing_printer_type" widget="radio"/>
                            <field name="auto_print_cash_closing"/>
                        </group>
                    </group>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
