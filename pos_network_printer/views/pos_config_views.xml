<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_network_printer" model="ir.ui.view">
        <field name="name">pos.config.view.form.qz_printer</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="network_printing_config" name="network_printing_config">
                    <group string="Local Ticket Printing (QZ Tray - No IoT Box)">
                        <div class="text-muted mb-3" colspan="2">
                            Direct local printing to thermal receipt printers via QZ Tray without IoT Box or cloud networking restrictions.
                        </div>
                        <group>
                            <field name="enable_network_printing"/>
                            <field name="qz_printer_name"
                                   placeholder="e.g. Bitaspain, POS-80 (leave blank for system default)"
                                   invisible="not enable_network_printing"/>
                            <field name="auto_print_on_payment"
                                   invisible="not enable_network_printing"/>
                        </group>
                    </group>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
