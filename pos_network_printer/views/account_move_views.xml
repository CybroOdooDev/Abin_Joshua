<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_ticket_80mm" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ticket.80mm</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="move_type" invisible="1"/>
                <button name="action_print_invoice_ticket_80mm"
                        string="Print Ticket (80mm)"
                        type="object"
                        class="btn-secondary"
                        icon="fa-print"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
