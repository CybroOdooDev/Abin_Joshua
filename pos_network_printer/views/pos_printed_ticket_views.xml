<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- POS Printed Ticket Form View -->
    <record id="view_pos_printed_ticket_form" model="ir.ui.view">
        <field name="name">pos.printed.ticket.form</field>
        <field name="model">pos.printed.ticket</field>
        <field name="arch" type="xml">
            <form string="Printed Ticket Record">
                <header>
                    <button name="action_reprint"
                            string="Reprint Original Ticket"
                            type="object"
                            class="btn-primary"
                            icon="fa-print"/>
                    <field name="status" widget="statusbar" statusbar_visible="success,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Ticket Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Order &amp; Session Info">
                            <field name="order_id" readonly="1"/>
                            <field name="session_id" readonly="1"/>
                            <field name="pos_reference" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group string="Print Execution Details">
                            <field name="print_date" readonly="1"/>
                            <field name="printer_id"/>
                            <field name="printer_name"/>
                            <field name="printer_ip"/>
                            <field name="print_type" widget="badge"/>
                            <field name="reprint_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Receipt Snapshot" name="snapshot">
                            <div class="alert alert-info" role="alert">
                                This snapshot preserves the exact layout, prices, and tax breakdown of the ticket as originally printed.
                            </div>
                            <field name="receipt_snapshot"
                                   widget="image"
                                   options="{'size': [380, 700]}"
                                   readonly="1"/>
                        </page>
                        <page string="Diagnostics / Errors" name="diagnostics" invisible="not error_message">
                            <group>
                                <field name="error_message" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- POS Printed Ticket Tree View -->
    <record id="view_pos_printed_ticket_tree" model="ir.ui.view">
        <field name="name">pos.printed.ticket.tree</field>
        <field name="model">pos.printed.ticket</field>
        <field name="arch" type="xml">
            <tree string="Printed Tickets History" create="false" edit="false">
                <field name="print_date"/>
                <field name="name"/>
                <field name="order_id"/>
                <field name="printer_name"/>
                <field name="user_id"/>
                <field name="print_type"
                       widget="badge"
                       decoration-info="print_type == 'first_print'"
                       decoration-warning="print_type == 'reprint'"/>
                <field name="status"
                       widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'failed'"/>
                <button name="action_reprint"
                        string="Reprint"
                        type="object"
                        icon="fa-print"
                        title="Reprint ticket"/>
            </tree>
        </field>
    </record>

    <!-- POS Printed Ticket Action -->
    <record id="action_pos_printed_ticket" model="ir.actions.act_window">
        <field name="name">Printed Tickets History</field>
        <field name="res_model">pos.printed.ticket</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Item under POS Orders -->
    <menuitem id="menu_pos_printed_ticket"
              name="Printed Tickets History"
              parent="point_of_sale.menu_point_of_sale"
              action="action_pos_printed_ticket"
              sequence="25"/>
</odoo>
