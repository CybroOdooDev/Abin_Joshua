<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_form_inherit_network_printer" model="ir.ui.view">
        <field name="name">pos.session.form.inherit.network.printer</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_printed_tickets"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-print">
                    <field name="closing_ticket_count" widget="statinfo" string="Printed Tickets"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Printed Tickets &amp; Closing Reports" name="printed_tickets">
                        <field name="closing_ticket_ids" readonly="1">
                            <tree string="Printed Tickets">
                                <field name="print_date"/>
                                <field name="name"/>
                                <field name="printer_name"/>
                                <field name="user_id"/>
                                <field name="print_type"
                                       widget="badge"
                                       decoration-info="print_type == 'first_print'"
                                       decoration-success="print_type == 'closing'"
                                       decoration-warning="print_type == 'reprint'"/>
                                <field name="status"
                                       widget="badge"
                                       decoration-success="status == 'success'"
                                       decoration-danger="status == 'failed'"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
