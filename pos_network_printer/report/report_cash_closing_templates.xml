<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cash_closing_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="data" t-value="o.get_cash_closing_report_data()"/>
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; color: #333;">
                        
                        <!-- Header Title -->
                        <div class="row mb-4 pb-2 border-bottom border-dark">
                            <div class="col-8">
                                <h2 class="fw-bold mb-1" style="color: #1a202c; letter-spacing: -0.5px;">POS Cash Closing Report</h2>
                                <div class="text-muted" style="font-size: 14px;">End of Session / Z-Report Financial Summary</div>
                            </div>
                            <div class="col-4 text-end">
                                <span class="badge bg-primary fs-6 px-3 py-2 text-uppercase" t-esc="data['session']['state']"/>
                            </div>
                        </div>

                        <!-- Session Meta Info -->
                        <div class="row mb-4 p-3 rounded" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                            <div class="col-6">
                                <div class="mb-1"><strong>POS Register:</strong> <span t-esc="data['session']['pos_name']"/></div>
                                <div class="mb-1"><strong>Session Reference:</strong> <span t-esc="data['session']['name']"/></div>
                                <div class="mb-1"><strong>Cashier / Responsible:</strong> <span t-esc="data['session']['cashier']"/></div>
                            </div>
                            <div class="col-6 text-end">
                                <div class="mb-1"><strong>Session Start:</strong> <span t-esc="data['session']['start_at'] or '-'"/></div>
                                <div class="mb-1"><strong>Session Close:</strong> <span t-esc="data['session']['stop_at'] or '-'"/></div>
                                <div class="mb-1"><strong>Report Generated:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/></div>
                            </div>
                        </div>

                        <!-- Key Performance KPI Cards -->
                        <div class="row g-3 mb-4">
                            <div class="col-3">
                                <div class="p-3 border rounded text-center bg-white shadow-sm">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 11px;">Opening Cash</div>
                                    <div class="fs-5 fw-bold text-dark mt-1" t-esc="data['cash_details']['opening_cash']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-3 border rounded text-center bg-white shadow-sm">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 11px;">Total Sales</div>
                                    <div class="fs-5 fw-bold text-primary mt-1" t-esc="data['sales_summary']['gross_sales']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-3 border rounded text-center bg-white shadow-sm">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 11px;">Counted Cash (Drawer)</div>
                                    <div class="fs-5 fw-bold text-success mt-1" t-esc="data['cash_details']['counted_cash']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-3 border rounded text-center bg-white shadow-sm">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 11px;">Difference</div>
                                    <div t-attf-class="fs-5 fw-bold mt-1 #{'text-danger' if abs(data['cash_details']['difference']) > 0.001 else 'text-muted'}"
                                         t-esc="data['cash_details']['difference']"
                                         t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </div>
                            </div>
                        </div>

                        <!-- 1. Cash Drawer Reconciliation (CashSecurity Integration) -->
                        <div class="card mb-4 border" style="border-color: #cbd5e1;">
                            <div class="card-header bg-light py-2 fw-bold" style="font-size: 14px;">
                                💵 Cash Drawer Balance (CashSecurity Integration)
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-sm table-striped mb-0">
                                    <tbody>
                                        <tr>
                                            <td class="ps-3 py-2">Opening Cash (Starting Float)</td>
                                            <td class="text-end pe-3 py-2 fw-semibold" t-esc="data['cash_details']['opening_cash']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                        <tr>
                                            <td class="ps-3 py-2">(+) Cash Sales Received</td>
                                            <td class="text-end pe-3 py-2 fw-semibold" t-esc="data['cash_details']['cash_sales']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                        <tr t-if="data['cash_details']['cash_in'] > 0">
                                            <td class="ps-3 py-2">(+) Cash In Movements</td>
                                            <td class="text-end pe-3 py-2 text-success fw-semibold" t-esc="data['cash_details']['cash_in']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                        <tr t-if="data['cash_details']['cash_out'] > 0">
                                            <td class="ps-3 py-2">(-) Cash Out Movements</td>
                                            <td class="text-end pe-3 py-2 text-danger fw-semibold" t-esc="-data['cash_details']['cash_out']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                        <tr class="table-secondary fw-bold">
                                            <td class="ps-3 py-2">Expected Cash in Drawer</td>
                                            <td class="text-end pe-3 py-2" t-esc="data['cash_details']['expected_cash']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                        <tr class="table-primary fw-bold">
                                            <td class="ps-3 py-2">Counted Closing Cash (Smart Drawer / CashSecurity)</td>
                                            <td class="text-end pe-3 py-2" t-esc="data['cash_details']['counted_cash']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                        <tr t-attf-class="fw-bold #{'table-danger text-danger' if abs(data['cash_details']['difference']) > 0.001 else 'table-light'}">
                                            <td class="ps-3 py-2">Closing Difference</td>
                                            <td class="text-end pe-3 py-2" t-esc="data['cash_details']['difference']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- 2. Dynamic Payment Methods Breakdown -->
                        <div class="card mb-4 border" style="border-color: #cbd5e1;">
                            <div class="card-header bg-light py-2 fw-bold" style="font-size: 14px;">
                                💳 Sales Breakdown by Payment Method (Dynamic Configuration)
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3 py-2">Payment Method</th>
                                            <th class="py-2">Type</th>
                                            <th class="text-center py-2">Transactions</th>
                                            <th class="text-end pe-3 py-2">Total Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="total_tx_count" t-value="0"/>
                                        <t t-foreach="data['payment_methods']" t-as="pm">
                                            <t t-set="total_tx_count" t-value="total_tx_count + pm['count']"/>
                                            <tr>
                                                <td class="ps-3 py-2 fw-medium">
                                                    <span t-if="pm['is_cash']">💵 </span>
                                                    <span t-else="">💳 </span>
                                                    <span t-esc="pm['name']"/>
                                                </td>
                                                <td class="py-2 text-capitalize text-muted" t-esc="pm['type']"/>
                                                <td class="text-center py-2" t-esc="pm['count']"/>
                                                <td class="text-end pe-3 py-2 fw-semibold" t-esc="pm['amount']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </tr>
                                        </t>
                                        <tr class="table-secondary fw-bold">
                                            <td colspan="2" class="ps-3 py-2 text-uppercase">Total Payment Collections</td>
                                            <td class="text-center py-2" t-esc="total_tx_count"/>
                                            <td class="text-end pe-3 py-2" t-esc="data['sales_summary']['gross_sales']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- 3. Sales Financial Summary -->
                        <div class="row">
                            <div class="col-6">
                                <div class="card border" style="border-color: #cbd5e1;">
                                    <div class="card-header bg-light py-2 fw-bold" style="font-size: 14px;">
                                        📊 Orders Summary
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span>Completed Orders:</span>
                                            <span class="fw-bold" t-esc="data['sales_summary']['total_orders']"/>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span>Net Sales (Untaxed):</span>
                                            <span class="fw-semibold" t-esc="data['sales_summary']['net_sales']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span>Taxes Collected:</span>
                                            <span class="fw-semibold" t-esc="data['sales_summary']['tax_total']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </div>
                                        <div class="d-flex justify-content-between pt-2 border-top fw-bold fs-6">
                                            <span>Gross Total Sales:</span>
                                            <span class="text-primary" t-esc="data['sales_summary']['gross_sales']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="card border h-100" style="border-color: #cbd5e1;">
                                    <div class="card-header bg-light py-2 fw-bold" style="font-size: 14px;">
                                        ✍️ Signatures &amp; Verification
                                    </div>
                                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                                        <div class="row pt-4">
                                            <div class="col-6 text-center">
                                                <div class="border-top pt-1 text-muted" style="font-size: 11px;">Cashier Signature</div>
                                                <div class="fw-semibold mt-1" t-esc="data['session']['cashier']"/>
                                            </div>
                                            <div class="col-6 text-center">
                                                <div class="border-top pt-1 text-muted" style="font-size: 11px;">Manager Signature</div>
                                                <div class="text-muted mt-1">___________________</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
