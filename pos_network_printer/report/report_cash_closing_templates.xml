<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cash_closing_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang=o.user_id.lang or env.user.lang)"/>
                <t t-set="data" t-value="o.get_cash_closing_report_data()"/>
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; color: #1e293b; padding: 10px 15px;">
                        
                        <!-- Header: Company Info (Left) & Document Title (Right) -->
                        <div class="row pb-2 mb-2 border-bottom border-dark align-items-center">
                            <div class="col-7">
                                <h4 class="fw-bold mb-0 text-uppercase" style="letter-spacing: -0.3px; color: #0f172a;" t-esc="data['company']['name']"/>
                                <div class="text-muted" style="font-size: 11px; line-height: 1.3;">
                                    <div t-if="data['company']['vat']">
                                        <span>VAT:</span> <span t-esc="data['company']['vat']"/>
                                    </div>
                                    <div t-if="data['company']['street']" t-esc="data['company']['street']"/>
                                    <div t-if="data['company']['city_zip']" t-esc="data['company']['city_zip']"/>
                                    <div t-elif="data['company']['address'] and not data['company']['street']" t-esc="data['company']['address']"/>
                                    <div t-if="data['company']['phone']">
                                        <span>Tel:</span> <span t-esc="data['company']['phone']"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-5 text-end">
                                <div class="fw-bold fs-5 text-uppercase" style="letter-spacing: 0.5px; color: #0f172a;">*** CASH CLOSING (Z) ***</div>
                                <div class="text-muted fw-semibold" style="font-size: 11px;">SESSION CLOSING REPORT</div>
                                <span class="badge bg-dark px-2 py-1 mt-1 text-uppercase" style="font-size: 10px;" t-esc="data['session']['state']"/>
                            </div>
                        </div>

                        <!-- Session Meta Info Strip -->
                        <div class="row p-2 mb-2 rounded" style="background-color: #f8fafc; border: 1px solid #e2e8f0; font-size: 11px;">
                            <div class="col-6">
                                <div class="mb-1"><strong>Terminal:</strong> <span t-esc="data['session']['pos_name']"/></div>
                                <div class="mb-1"><strong>Session:</strong> <span t-esc="data['session']['name']"/></div>
                                <div><strong>Cashier:</strong> <span t-esc="data['session']['cashier']"/></div>
                            </div>
                            <div class="col-6 text-end">
                                <div class="mb-1"><strong>Opening:</strong> <span t-esc="data['session']['start_at'] or '-'"/></div>
                                <div class="mb-1"><strong>Closing:</strong> <span t-esc="data['session']['stop_at'] or '-'"/></div>
                                <div><strong>Printed on</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M:%S')"/></div>
                            </div>
                        </div>

                        <!-- 4 Key Metric KPI Cards -->
                        <div class="row g-2 mb-2">
                            <div class="col-3">
                                <div class="p-2 border rounded text-center bg-white">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 10px;">Starting Float:</div>
                                    <div class="fs-6 fw-bold text-dark mt-1" t-esc="data['cash_details']['opening_cash']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 border rounded text-center bg-white">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 10px;">TOTAL SALES</div>
                                    <div class="fs-6 fw-bold text-primary mt-1" t-esc="data['sales_summary']['gross_sales']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 border rounded text-center bg-white">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 10px;">Counted Cash (Drawer):</div>
                                    <div class="fs-6 fw-bold text-success mt-1" t-esc="data['cash_details']['counted_cash']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 border rounded text-center bg-white">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 10px;">Difference:</div>
                                    <div t-attf-class="fs-6 fw-bold mt-1 #{'text-danger' if abs(data['cash_details']['difference']) > 0.01 else 'text-muted'}"
                                         t-esc="data['cash_details']['difference']"
                                         t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </div>
                            </div>
                        </div>

                        <!-- 1. Cash Drawer Balance Table -->
                        <div class="card mb-2 border" style="border-color: #cbd5e1;">
                            <div class="card-header bg-light py-1 px-2 fw-bold" style="font-size: 11px;">
                                CASH DRAWER BALANCE
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-sm mb-0" style="font-size: 11px;">
                                    <tbody>
                                        <tr>
                                            <td class="ps-2 py-1">Starting Float:</td>
                                            <td class="text-end pe-2 py-1 fw-semibold" t-esc="data['cash_details']['opening_cash']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                        <tr>
                                            <td class="ps-2 py-1">(+) Cash Sales:</td>
                                            <td class="text-end pe-2 py-1 fw-semibold" t-esc="data['cash_details']['cash_sales']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                        <tr t-if="data['cash_details']['cash_in'] > 0">
                                            <td class="ps-2 py-1">(+) Cash In:</td>
                                            <td class="text-end pe-2 py-1 text-success fw-semibold" t-esc="data['cash_details']['cash_in']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                        <tr t-if="data['cash_details']['cash_out'] > 0">
                                            <td class="ps-2 py-1">(-) Cash Out:</td>
                                            <td class="text-end pe-2 py-1 text-danger fw-semibold" t-esc="data['cash_details']['cash_out']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                        <tr class="table-light fw-bold" style="border-top: 1px dashed #94a3b8;">
                                            <td class="ps-2 py-1">Expected Cash:</td>
                                            <td class="text-end pe-2 py-1" t-esc="data['cash_details']['expected_cash']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                        <tr style="background-color: #f8fafc;" class="fw-bold">
                                            <td class="ps-2 py-1">Counted Cash (Drawer):</td>
                                            <td class="text-end pe-2 py-1" t-esc="data['cash_details']['counted_cash']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                        <tr t-attf-class="fw-bold #{'table-danger text-danger' if abs(data['cash_details']['difference']) > 0.01 else ''}">
                                            <td class="ps-2 py-1">Difference:</td>
                                            <td class="text-end pe-2 py-1" t-esc="data['cash_details']['difference']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- 2. Dynamic Payment Methods Breakdown -->
                        <div class="card mb-2 border" style="border-color: #cbd5e1;">
                            <div class="card-header bg-light py-1 px-2 fw-bold" style="font-size: 11px;">
                                SALES BY PAYMENT METHOD
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-sm mb-0" style="font-size: 11px;">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-2 py-1">Payment Method</th>
                                            <th class="text-center py-1">Transactions</th>
                                            <th class="text-end pe-2 py-1">TOTAL SALES</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="total_tx_count" t-value="0"/>
                                        <t t-foreach="data['payment_methods']" t-as="pm">
                                            <t t-set="total_tx_count" t-value="total_tx_count + pm['count']"/>
                                            <tr>
                                                <td class="ps-2 py-1 fw-medium" t-esc="pm['name']"/>
                                                <td class="text-center py-1">
                                                    <span t-esc="pm['count']"/> <span>Transactions</span>
                                                </td>
                                                <td class="text-end pe-2 py-1 fw-semibold" t-esc="pm['amount']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                            </tr>
                                        </t>
                                        <tr class="table-light fw-bold" style="border-top: 1px solid #94a3b8;">
                                            <td class="ps-2 py-1">TOTAL SALES</td>
                                            <td class="text-center py-1">
                                                <span t-esc="total_tx_count"/> <span>Transactions</span>
                                            </td>
                                            <td class="text-end pe-2 py-1" t-esc="data['sales_summary']['gross_sales']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- 3. Bottom Row: Orders Summary (Left) & Signatures (Right) -->
                        <div class="row g-2 mb-2">
                            <!-- Left: Orders Financial Summary -->
                            <div class="col-6">
                                <div class="card border h-100" style="border-color: #cbd5e1;">
                                    <div class="card-header bg-light py-1 px-2 fw-bold" style="font-size: 11px;">
                                        Orders Summary
                                    </div>
                                    <div class="card-body p-2" style="font-size: 11px;">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span>Total Orders / Tickets:</span>
                                            <span class="fw-bold" t-esc="data['sales_summary']['total_orders']"/>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span>Net Sales (Untaxed):</span>
                                            <span class="fw-semibold" t-esc="data['sales_summary']['net_sales']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span>Taxes:</span>
                                            <span class="fw-semibold" t-esc="data['sales_summary']['tax_total']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </div>
                                        <div class="d-flex justify-content-between pt-1 border-top fw-bold" style="font-size: 12px;">
                                            <span>TOTAL SALES</span>
                                            <span class="text-primary" t-esc="data['sales_summary']['gross_sales']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Signatures & Verification -->
                            <div class="col-6">
                                <div class="card border h-100" style="border-color: #cbd5e1;">
                                    <div class="card-header bg-light py-1 px-2 fw-bold" style="font-size: 11px;">
                                        Signatures &amp; Verification
                                    </div>
                                    <div class="card-body p-2 d-flex flex-column justify-content-between" style="font-size: 11px;">
                                        <div class="row pt-3">
                                            <div class="col-6 text-center">
                                                <div class="border-top pt-1 text-muted" style="font-size: 10px;">Cashier Signature</div>
                                                <div class="fw-semibold mt-1" t-esc="data['session']['cashier']"/>
                                            </div>
                                            <div class="col-6 text-center">
                                                <div class="border-top pt-1 text-muted" style="font-size: 10px;">Manager Signature</div>
                                                <div class="text-muted mt-1">___________________</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
