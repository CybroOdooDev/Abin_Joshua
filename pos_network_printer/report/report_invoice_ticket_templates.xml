<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_ticket_document">
        <t t-call="web.basic_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or o.company_id.partner_id.lang)"/>
            <div class="page" style="width: 76mm; max-width: 76mm; margin: 0 auto; padding: 2px 0; font-family: 'Courier New', Courier, monospace; font-size: 11px; line-height: 1.25; color: #000; word-break: break-word;">

                <!-- Company Logo -->
                <t t-if="o.company_id.logo">
                    <div style="text-align: center; margin-bottom: 6px;">
                        <img t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 48px; max-width: 65mm; object-fit: contain; margin: 0 auto; display: block;" alt="Logo"/>
                    </div>
                </t>

                <!-- Company Details -->
                <div style="text-align: center; margin-bottom: 4px;">
                    <div style="font-weight: bold; font-size: 13px;"><t t-esc="o.company_id.name"/></div>
                    <t t-if="o.company_id.vat">
                        <div>
                            <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                            <t t-else="">NIF/CIF</t>: <span t-field="o.company_id.vat"/>
                        </div>
                    </t>
                    <div t-if="o.company_id.street"><span t-field="o.company_id.street"/></div>
                    <div t-if="o.company_id.city or o.company_id.zip">
                        <span t-field="o.company_id.zip"/> <span t-field="o.company_id.city"/>
                    </div>
                    <div t-if="o.company_id.phone">Tel: <span t-field="o.company_id.phone"/></div>
                    <div t-if="o.company_id.email"><span t-field="o.company_id.email"/></div>
                </div>

                <div style="border-top: 1px dashed #000; margin: 6px 0;"></div>

                <!-- Invoice Header -->
                <div style="text-align: center; font-weight: bold; font-size: 14px; margin-bottom: 2px;">
                    <t t-if="o.partner_id and o.partner_id.vat and o.partner_id != o.company_id.partner_id">
                        FACTURA
                    </t>
                    <t t-else="">
                        FACTURA SIMPLIFICADA
                    </t>
                </div>
                <div style="text-align: center; font-size: 11px; margin-bottom: 4px;">
                    <div><strong>Nº Factura:</strong> <span t-field="o.name"/></div>
                    <div>
                        <strong>Fecha:</strong> <span t-field="o.invoice_date"/>
                        <t t-if="o.create_date">
                            <span t-esc="o.create_date.strftime(' %H:%M')"/>
                        </t>
                    </div>
                    <t t-if="o.invoice_origin">
                        <div><strong>Origen:</strong> <span t-field="o.invoice_origin"/></div>
                    </t>
                    <t t-elif="o.pos_order_ids">
                        <div><strong>Origen:</strong> <span t-esc="o.pos_order_ids[0].name"/></div>
                    </t>
                </div>

                <!-- Customer Details (Datos del Cliente) -->
                <t t-if="o.partner_id and o.partner_id != o.company_id.partner_id">
                    <div style="border: 1px dashed #000; padding: 4px 6px; margin: 6px 0; font-size: 10px;">
                        <div style="font-weight: bold; text-decoration: underline; margin-bottom: 2px;">DATOS DEL CLIENTE:</div>
                        <div><strong>Nombre:</strong> <span t-field="o.partner_id.name"/></div>
                        <div t-if="o.partner_id.vat"><strong>NIF/CIF:</strong> <span t-field="o.partner_id.vat"/></div>
                        <div t-if="o.partner_id.contact_address"><strong>Dirección:</strong> <span t-field="o.partner_id.contact_address"/></div>
                        <div t-if="o.partner_id.phone"><strong>Teléfono:</strong> <span t-field="o.partner_id.phone"/></div>
                        <div t-if="o.partner_id.email"><strong>Email:</strong> <span t-field="o.partner_id.email"/></div>
                    </div>
                </t>

                <div style="border-top: 1px dashed #000; margin: 6px 0;"></div>

                <!-- Product Lines -->
                <table style="width: 100%; font-size: 10px; border-collapse: collapse; margin-bottom: 4px;">
                    <thead>
                        <tr style="border-bottom: 1px dashed #000; font-weight: bold;">
                            <th style="width: 45%; text-align: left; padding: 2px 0;">Descrip.</th>
                            <th style="width: 15%; text-align: center; padding: 2px 0;">Ud.</th>
                            <th style="width: 20%; text-align: right; padding: 2px 0;">Precio</th>
                            <th style="width: 20%; text-align: right; padding: 2px 0;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.invoice_line_ids.filtered(lambda l: not l.display_type)" t-as="line">
                            <tr>
                                <td style="padding: 2px 0; vertical-align: top;">
                                    <span t-field="line.product_id.name" t-if="line.product_id"/>
                                    <span t-field="line.name" t-else=""/>
                                </td>
                                <td style="text-align: center; padding: 2px 0; vertical-align: top;">
                                    <span t-esc="'%.0f' % line.quantity if line.quantity.is_integer() else '%.2f' % line.quantity"/>
                                </td>
                                <td style="text-align: right; padding: 2px 0; vertical-align: top;">
                                    <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td style="text-align: right; padding: 2px 0; vertical-align: top;">
                                    <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div style="border-top: 1px dashed #000; margin: 6px 0;"></div>

                <!-- Totals & Taxes Breakdown -->
                <table style="width: 100%; font-size: 11px; margin-bottom: 4px;">
                    <tr>
                        <td style="padding: 1px 0;">BASE IMPONIBLE</td>
                        <td style="text-align: right; padding: 1px 0;">
                            <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                    <!-- Tax Breakdown -->
                    <t t-set="tax_totals" t-value="o.tax_totals or {}"/>
                    <t t-if="tax_totals and 'groups_by_subtotal' in tax_totals">
                        <t t-foreach="tax_totals['groups_by_subtotal']" t-as="subtotal_title">
                            <t t-foreach="tax_totals['groups_by_subtotal'][subtotal_title]" t-as="tax_group">
                                <tr>
                                    <td style="padding: 1px 0;">
                                        <t t-esc="tax_group['tax_group_name']"/>
                                        <t t-if="'tax_group_base_amount' in tax_group and tax_group['tax_group_base_amount']">
                                            (<span t-esc="tax_group['formatted_tax_group_base_amount']"/>)
                                        </t>
                                    </td>
                                    <td style="text-align: right; padding: 1px 0;">
                                        <t t-esc="tax_group['formatted_tax_group_amount']"/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </t>
                    <t t-else="">
                        <tr>
                            <td style="padding: 1px 0;">TOTAL IVA</td>
                            <td style="text-align: right; padding: 1px 0;">
                                <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </t>
                    <tr style="border-top: 1px solid #000; font-weight: bold; font-size: 14px;">
                        <td style="padding: 4px 0;">TOTAL</td>
                        <td style="text-align: right; padding: 4px 0;">
                            <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                </table>

                <!-- Payments -->
                <t t-if="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget.get('content')">
                    <div style="border-top: 1px dashed #000; margin: 4px 0;"></div>
                    <div style="font-size: 10px;">
                        <t t-foreach="o.sudo().invoice_payments_widget['content']" t-as="payment_vals">
                            <div style="display: flex; justify-content: space-between;">
                                <span>Pagado (<t t-esc="payment_vals.get('journal_name', 'Pago')"/>):</span>
                                <span style="float: right;">
                                    <t t-esc="payment_vals.get('amount', 0)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </span>
                            </div>
                        </t>
                        <div t-if="o.amount_residual > 0" style="display: flex; justify-content: space-between; font-weight: bold; margin-top: 2px;">
                            <span>Importe pendiente:</span>
                            <span style="float: right;">
                                <span t-field="o.amount_residual" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </span>
                        </div>
                    </div>
                </t>
                <t t-elif="o.pos_order_ids and o.pos_order_ids[0].payment_ids">
                    <div style="border-top: 1px dashed #000; margin: 4px 0;"></div>
                    <div style="font-size: 10px;">
                        <t t-foreach="o.pos_order_ids[0].payment_ids" t-as="p">
                            <div style="display: flex; justify-content: space-between;">
                                <span><t t-esc="p.payment_method_id.name"/>:</span>
                                <span style="float: right;">
                                    <t t-esc="p.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </span>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Veri*Factu QR -->
                <t t-set="verifactu_qr" t-value="getattr(o, 'l10n_es_edi_verifactu_qr_image', False)"/>
                <t t-if="verifactu_qr">
                    <div style="border-top: 1px dashed #000; margin: 8px 0;"></div>
                    <div style="text-align: center; font-size: 10px;">
                        <div style="font-weight: bold; margin-bottom: 2px;">QR tributario:</div>
                        <img t-att-src="image_data_uri(verifactu_qr)" style="width: 32mm; height: 32mm; margin: 0 auto; display: block;" alt="Veri*Factu QR"/>
                        <div style="font-weight: bold; margin-top: 2px; font-size: 11px;">VERI*FACTU</div>
                    </div>
                </t>

                <div style="border-top: 1px dashed #000; margin: 8px 0;"></div>
                <div style="text-align: center; font-size: 10px; margin-top: 4px;">
                    Gracias por su visita
                </div>

            </div>
        </t>
    </template>

    <template id="report_invoice_ticket">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="pos_network_printer.report_invoice_ticket_document" t-lang="o.partner_id.lang or o.company_id.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
