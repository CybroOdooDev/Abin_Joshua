<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_ticket_document">
        <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or o.company_id.partner_id.lang)"/>
        <div class="article page pos-ticket-wrap" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
            <style>
                .pos-ticket-wrap {
                    width: 72mm !important;
                    max-width: 72mm !important;
                    margin: 0 auto !important;
                    padding: 0 !important;
                    font-family: Arial, Helvetica, sans-serif !important;
                    font-size: 13px !important;
                    line-height: 1.35 !important;
                    color: #000000 !important;
                    box-sizing: border-box !important;
                    -webkit-font-smoothing: antialiased !important;
                }
                .pos-ticket-wrap,
                .pos-ticket-wrap * {
                    color: #000000 !important;
                    box-sizing: border-box !important;
                }
                .pos-ticket-wrap table {
                    width: 100% !important;
                    border-collapse: collapse !important;
                    margin: 0 !important;
                }
                .pos-ticket-wrap table,
                .pos-ticket-wrap table thead,
                .pos-ticket-wrap table tbody,
                .pos-ticket-wrap table tfoot,
                .pos-ticket-wrap table tr,
                .pos-ticket-wrap table td,
                .pos-ticket-wrap table th {
                    border: 0 none !important;
                    border-style: none !important;
                    border-width: 0 !important;
                    outline: none !important;
                    box-shadow: none !important;
                    background: transparent !important;
                }
                .pos-ticket-wrap table td,
                .pos-ticket-wrap table th {
                    padding: 2px 2px !important;
                    vertical-align: top !important;
                }
                .pos-ticket-wrap table tr.tax-header-row th {
                    border-bottom: 1px dashed #000000 !important;
                    padding-bottom: 3px !important;
                }
                .pos-ticket-wrap table tr.tax-total-row td {
                    border-top: 1px dashed #000000 !important;
                    padding-top: 3px !important;
                }
                .pos-ticket-wrap .ticket-row {
                    display: table !important;
                    width: 100% !important;
                    border: none !important;
                }
                .pos-ticket-wrap .ticket-row-name {
                    display: table-cell !important;
                    text-align: left !important;
                    vertical-align: top !important;
                    padding-right: 12px !important;
                    font-size: 13px !important;
                    font-weight: bold !important;
                    word-wrap: break-word !important;
                    overflow-wrap: break-word !important;
                }
                .pos-ticket-wrap .ticket-row-price {
                    display: table-cell !important;
                    text-align: right !important;
                    vertical-align: top !important;
                    white-space: nowrap !important;
                    width: 1% !important;
                    font-size: 13px !important;
                    font-weight: bold !important;
                }
                .pos-ticket-wrap .ticket-total-row {
                    display: table !important;
                    width: 100% !important;
                    margin: 4px 0 8px 0 !important;
                    font-size: 17px !important;
                    font-weight: 900 !important;
                    border: none !important;
                }
                .pos-ticket-wrap .ticket-total-label {
                    display: table-cell !important;
                    text-align: left !important;
                    vertical-align: middle !important;
                }
                .pos-ticket-wrap .ticket-total-amount {
                    display: table-cell !important;
                    text-align: right !important;
                    vertical-align: middle !important;
                    white-space: nowrap !important;
                    padding-left: 12px !important;
                }
                .pos-ticket-wrap .ticket-line-item {
                    border: none !important;
                    border-width: 0 !important;
                    outline: none !important;
                    box-shadow: none !important;
                    margin: 6px 0 !important;
                    padding: 0 !important;
                }
                .pos-ticket-wrap .ticket-line-combo {
                    border: none !important;
                    border-left: 2px solid #000000 !important;
                    outline: none !important;
                    box-shadow: none !important;
                    margin: 3px 0 4px 12px !important;
                    padding: 0 0 0 8px !important;
                }
                .pos-ticket-wrap .ticket-line-details {
                    font-size: 11px !important;
                    font-weight: 600 !important;
                    color: #000000 !important;
                    padding-left: 4px !important;
                    margin-top: 1px !important;
                }
                .pos-ticket-wrap .ticket-divider {
                    border-top: 1px dashed #000000 !important;
                    margin: 6px 0 !important;
                    height: 1px !important;
                }
                @media print {
                    html, body {
                        margin: 0 !important;
                        padding: 0 !important;
                    }
                    .pos-ticket-wrap {
                        page-break-inside: avoid !important;
                        break-inside: avoid !important;
                        page-break-after: avoid !important;
                        break-after: avoid !important;
                    }
                    .pos-ticket-wrap * {
                        page-break-inside: avoid !important;
                        break-inside: avoid !important;
                    }
                }
            </style>

            <!-- 1. Header (matches POS OrderReceipt) -->
            <div style="text-align: center; font-weight: bold; font-size: 16px; margin-bottom: 4px;">
                <t t-if="o.partner_id and o.partner_id.vat and o.partner_id != o.company_id.partner_id">
                    FACTURA
                </t>
                <t t-else="">
                    FACTURA SIMPLIFICADA
                </t>
            </div>
            <div style="text-align: center; margin-bottom: 12px; font-size: 13px;">
                <t t-if="o.partner_id and o.partner_id.vat and o.partner_id != o.company_id.partner_id">
                    Nº Factura: <strong><span t-field="o.name"/></strong>
                </t>
                <t t-elif="o.pos_order_ids">
                    Nº de Ticket: <strong><span t-esc="o.pos_order_ids[0].name"/></strong>
                </t>
                <t t-elif="o.invoice_origin">
                    Nº de Ticket: <strong><span t-field="o.invoice_origin"/></strong>
                </t>
                <t t-else="">
                    Nº de Ticket: <strong><span t-field="o.name"/></strong>
                </t>
            </div>

            <!-- 2. Company Logo & Info (matches POS ReceiptHeader) -->
            <t t-if="o.company_id.logo">
                <div style="text-align: center; margin-bottom: 8px;">
                    <img t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 50px; max-width: 50mm; object-fit: contain; margin: 0 auto; display: block;" alt="Logo"/>
                </div>
            </t>
            <div style="text-align: center; font-size: 11px; margin-bottom: 10px;">
                <div><strong><t t-esc="o.company_id.name"/></strong></div>
                <div t-if="o.company_id.street"><span t-field="o.company_id.street"/></div>
                <div t-if="o.company_id.street2"><span t-field="o.company_id.street2"/></div>
                <div t-if="o.company_id.zip"><span t-field="o.company_id.zip"/></div>
                <div t-if="o.company_id.city"><span t-field="o.company_id.city"/></div>
                <div t-if="o.company_id.state_id">(<span t-esc="o.company_id.state_id.display_name"/>)</div>
                <div t-if="o.company_id.phone">Tel: <span t-field="o.company_id.phone"/></div>
                <t t-if="o.company_id.vat">
                    <div>
                        <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                        <t t-else="">NIF</t>: <span t-field="o.company_id.vat"/>
                    </div>
                </t>
                <div t-if="o.company_id.email"><span t-field="o.company_id.email"/></div>
                <div t-if="o.company_id.website"><span t-field="o.company_id.website"/></div>
                <div class="ticket-divider"></div>
                <t t-if="o.pos_order_ids and o.pos_order_ids[0].user_id">
                    <div>Atendido por <t t-esc="o.pos_order_ids[0].user_id.name"/></div>
                </t>
                <t t-elif="o.invoice_user_id">
                    <div>Atendido por <t t-esc="o.invoice_user_id.name"/></div>
                </t>
                <t t-if="o.pos_order_ids and o.pos_order_ids[0].table_id">
                    <div>en mesa <t t-esc="o.pos_order_ids[0].table_id.name"/></div>
                </t>
                <t t-if="o.pos_order_ids and o.pos_order_ids[0].customer_count">
                    <div>Comensales: <t t-esc="o.pos_order_ids[0].customer_count"/></div>
                </t>
                <t t-if="o.pos_order_ids and o.pos_order_ids[0].tracking_number">
                    <div style="font-size: 16px; font-weight: bold; margin-top: 2px;"><t t-esc="o.pos_order_ids[0].tracking_number"/></div>
                </t>
            </div>

            <!-- Customer Details (matches POS OrderReceipt) -->
            <t t-if="o.partner_id and o.partner_id != o.company_id.partner_id">
                <div style="border-top: 1px dashed #000000; border-bottom: 1px dashed #000000; padding: 4px 0; margin: 8px 0; font-size: 11px; text-align: left;">
                    <div style="font-weight: bold; text-decoration: underline; margin-bottom: 2px;">Datos del cliente:</div>
                    <div><strong>Cliente: </strong><span t-field="o.partner_id.name"/></div>
                    <div t-if="o.partner_id.vat"><strong>NIF: </strong><span t-field="o.partner_id.vat"/></div>
                    <div t-if="o.partner_id.phone or o.partner_id.mobile"><strong>Teléfono: </strong><t t-esc="o.partner_id.phone or o.partner_id.mobile"/></div>
                    <div t-if="o.partner_id.email"><strong>Correo: </strong><span t-field="o.partner_id.email"/></div>
                    <t t-set="addr" t-value="', '.join(filter(bool, [o.partner_id.street, o.partner_id.street2, o.partner_id.zip, o.partner_id.city, o.partner_id.country_id.name if o.partner_id.country_id else '']))"/>
                    <div t-if="addr"><strong>Dirección: </strong><t t-esc="addr"/></div>
                </div>
            </t>

            <!-- 3. Orderlines (matches POS OrderReceipt & Orderline) -->
            <div style="margin: 8px 0; border: none !important;">
                <t t-foreach="o._get_ticket_lines()" t-as="line">
                    <div t-att-class="'ticket-line-combo' if line['is_combo_child'] else 'ticket-line-item'">
                        <div class="ticket-row">
                            <div class="ticket-row-name">
                                <t t-esc="line['name']"/>
                            </div>
                            <div class="ticket-row-price">
                                <span t-esc="line['price_total']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </div>
                        </div>
                        <div class="ticket-line-details">
                            <t t-esc="line['qty_str']"/> <t t-esc="line['unit_name']"/>
                            <span> x </span>
                            <span t-esc="line['price_unit']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            <span> / </span>
                            <t t-esc="line['unit_name']"/>
                            <t t-if="line['discount'] and line['discount'] > 0">
                                <span style="margin-left: 4px; font-style: italic;">
                                    (<t t-esc="line['discount']"/>% dto.)
                                </span>
                            </t>
                        </div>
                    </div>
                </t>
            </div>

            <!-- 4. TOTAL -->
            <div class="ticket-divider"></div>
            <div class="ticket-total-row">
                <div class="ticket-total-label">TOTAL</div>
                <div class="ticket-total-amount">
                    <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                </div>
            </div>
            <div class="ticket-divider"></div>

            <!-- 5. Tax Breakdown (matches POS pos-receipt-taxes 4-column grid) -->
            <table border="0" cellpadding="0" cellspacing="0" style="width: 100%; font-size: 11px; margin: 8px 0;">
                <thead>
                    <tr class="tax-header-row" style="font-weight: bold;">
                        <th style="text-align: left; width: 25%;">Impuesto</th>
                        <th style="text-align: right; width: 25%;">Cuota</th>
                        <th style="text-align: right; width: 25%;">Base</th>
                        <th style="text-align: right; width: 25%;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="tax_totals" t-value="o.tax_totals or {}"/>
                    <t t-if="tax_totals and 'groups_by_subtotal' in tax_totals">
                        <t t-foreach="tax_totals['groups_by_subtotal']" t-as="subtotal_title">
                            <t t-foreach="tax_totals['groups_by_subtotal'][subtotal_title]" t-as="tax_group">
                                <t t-set="tax_base" t-value="tax_group.get('tax_group_base_amount', 0)"/>
                                <t t-set="tax_amt" t-value="tax_group.get('tax_group_amount', 0)"/>
                                <tr>
                                    <td style="text-align: left; padding: 2px 0;">
                                        <t t-esc="tax_group.get('tax_group_name')"/>
                                    </td>
                                    <td style="text-align: right; white-space: nowrap; padding: 2px 0;">
                                        <t t-esc="'%.2f' % tax_amt"/>
                                    </td>
                                    <td style="text-align: right; white-space: nowrap; padding: 2px 0;">
                                        <t t-esc="'%.2f' % tax_base"/>
                                    </td>
                                    <td style="text-align: right; white-space: nowrap; padding: 2px 0;">
                                        <t t-esc="'%.2f' % (tax_base + tax_amt)"/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                        <tr class="tax-total-row" style="font-weight: bold;">
                            <td></td>
                            <td style="text-align: right; white-space: nowrap;">
                                <t t-esc="'%.2f' % o.amount_tax"/>
                            </td>
                            <td style="text-align: right; white-space: nowrap;">
                                <t t-esc="'%.2f' % o.amount_untaxed"/>
                            </td>
                            <td style="text-align: right; white-space: nowrap;">
                                <t t-esc="'%.2f' % o.amount_total"/>
                            </td>
                        </tr>
                    </t>
                    <t t-else="">
                        <tr>
                            <td style="text-align: left;">IVA</td>
                            <td style="text-align: right;"><t t-esc="'%.2f' % o.amount_tax"/></td>
                            <td style="text-align: right;"><t t-esc="'%.2f' % o.amount_untaxed"/></td>
                            <td style="text-align: right;"><t t-esc="'%.2f' % o.amount_total"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <!-- 6. Veri*Factu QR (Spanish EDI) -->
            <t t-set="verifactu_qr" t-value="o._get_verifactu_qr_data_uri()"/>
            <t t-if="verifactu_qr">
                <div style="text-align: center; margin: 12px 0 8px 0;">
                    <div style="font-size: 11px; font-weight: bold; margin-bottom: 4px;">QR tributario:</div>
                    <img t-att-src="verifactu_qr" style="width: 32mm; height: 32mm; margin: 0 auto; display: block; image-rendering: pixelated;" alt="Veri*Factu QR"/>
                    <div style="font-size: 11px; font-weight: bold; margin-top: 4px;">VERI*FACTU</div>
                </div>
            </t>

            <!-- 7. Footer (matches POS OrderReceipt footer) -->
            <div style="text-align: center; font-size: 11px; color: #000000; margin-top: 12px;">
                <div class="ticket-divider"></div>
                <div>Powered by Odoo</div>
                <div style="margin-top: 2px;">
                    <t t-if="o.pos_order_ids">
                        <span t-esc="o.pos_order_ids[0].name"/>
                    </t>
                    <t t-elif="o.invoice_origin">
                        <span t-field="o.invoice_origin"/>
                    </t>
                    <t t-else="">
                        <span t-field="o.name"/>
                    </t>
                </div>
                <div>
                    <t t-if="o.pos_order_ids and o.pos_order_ids[0].date_order">
                        <span t-esc="o.pos_order_ids[0].date_order.strftime('%m/%d/%Y %H:%M:%S')"/>
                    </t>
                    <t t-elif="o.create_date">
                        <span t-esc="o.create_date.strftime('%m/%d/%Y %H:%M:%S')"/>
                    </t>
                </div>
            </div>

        </div>
    </template>

    <template id="report_invoice_ticket">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="pos_network_printer.report_invoice_ticket_document" t-lang="o.partner_id.lang or o.company_id.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
