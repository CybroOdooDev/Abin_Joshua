<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_inherit_custom_invoice" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.custom.invoice</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="refund_sequence" position="after">
                <field name="invoice_starting_number" invisible="type != 'sale'"/>
            </field>
        </field>
    </record>
</odoo>

