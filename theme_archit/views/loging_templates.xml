<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Loging page template -->
    <template id="inherit_login_page" inherit_id="web.login">
        <xpath expr="//form" position="replace">
            <section class="login loging_enter">
                <div class="container d-flex justify-center h-full">
                    <div class="wrapper">
                        <div class="row">
                            <div class="col-12">
                                <form t-attf-class="oe_login_form o_login_form #{'' if login else 'd-none'}" role="form"
                                      t-attf-action="/web/login"
                                      method="post"
                                      onsubmit="this.action = '/web/login' + location.hash">
                                    <div class="login_form loging_template">
                                        <h3>Login with Rader</h3>
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="form-group"
                                                     t-if="databases and len(databases) &gt; 1">
                                                    <label for="db"
                                                           class="col-form-label">
                                                        Database
                                                    </label>
                                                    <div t-attf-class="input-group {{'input-group-sm' if form_small else ''}}">
                                                        <input type="text"
                                                               name="db"
                                                               t-att-value="request.db"
                                                               id="db"
                                                               t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                                                               required="required"
                                                               readonly="readonly"/>
                                                        <a role="button"
                                                           href="/web/database/selector"
                                                           class="btn btn-secondary d-flex align-items-center gap-1">
                                                            Select
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="o_database_icon ms-1" viewBox="0 0 16 16" role="img" aria-label="Database" title="Database">
                                                                <path d="M4.318 2.687C5.234 2.271 6.536 2 8 2s2.766.27 3.682.687C12.644 3.125 13 3.627 13 4c0 .374-.356.875-1.318 1.313C10.766 5.729 9.464 6 8 6s-2.766-.27-3.682-.687C3.356 4.875 3 4.373 3 4c0-.374.356-.875 1.318-1.313ZM13 5.698V7c0 .374-.356.875-1.318 1.313C10.766 8.729 9.464 9 8 9s-2.766-.27-3.682-.687C3.356 7.875 3 7.373 3 7V5.698c.271.202.58.378.904.525C4.978 6.711 6.427 7 8 7s3.022-.289 4.096-.777A4.92 4.92 0 0 0 13 5.698ZM14 4c0-1.007-.875-1.755-1.904-2.223C11.022 1.289 9.573 1 8 1s-3.022.289-4.096.777C2.875 2.245 2 2.993 2 4v9c0 1.007.875 1.755 1.904 2.223C4.978 15.71 6.427 16 8 16s3.022-.289 4.096-.777C13.125 14.755 14 14.007 14 13V4Zm-1 4.698V10c0 .374-.356.875-1.318 1.313C10.766 11.729 9.464 12 8 12s-2.766-.27-3.682-.687C3.356 10.875 3 10.373 3 10V8.698c.271.202.58.378.904.525C4.978 9.711 6.427 10 8 10s3.022-.289 4.096-.777A4.92 4.92 0 0 0 13 8.698Zm0 3V13c0 .374-.356.875-1.318 1.313C10.766 14.729 9.464 15 8 15s-2.766-.27-3.682-.687C3.356 13.875 3 13.373 3 13v-1.302c.271.202.58.378.904.525C4.978 12.711 6.427 13 8 13s3.022-.289 4.096-.777c.324-.147.633-.323.904-.525Z"/>
                                                            </svg>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="form-group">
                                                    <label for="login" class="form-label d-flex justify-content-between">Email</label>
                                                    <input type="text"
                                                           placeholder="Enter your email"
                                                           name="login"
                                                           t-att-value="login"
                                                           id="login"
                                                           t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                                                           required="required"
                                                           autofocus="autofocus"
                                                           autocapitalize="off"/>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="form-group">
                                                    <label for="password" class="form-label d-flex justify-content-between">Password</label>
                                                    <input type="password"
                                                           placeholder="Enter your Password"
                                                           name="password"
                                                           id="password"
                                                           t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                                                           required="required"
                                                           autocomplete="current-password"
                                                           t-att-autofocus="'autofocus' if login else None"
                                                           maxlength="4096"/>
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="form-group">
                                                    <p class="alert alert-danger"
                                                       t-if="error"
                                                       role="alert">
                                                        <t t-esc="error"/>
                                                    </p>
                                                    <p class="alert alert-success"
                                                       t-if="message"
                                                       role="status">
                                                        <t t-esc="message"/>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center justify-content-between mb-2 px-0">
                                                <div class="form-check m-0 d-flex align-items-center">
                                                    <input class="form-check-input me-2" type="checkbox" value="" id="flexCheckDefault"/>
                                                    <label class="form-check-label m-0" for="flexCheckDefault">Remember Me</label>
                                                </div>
                                                <div class="oe_login_buttons o_login_buttons d-flex align-items-center m-0">
                                                    <button type="submit" class="btn btn-black px-4" style="width: fit-content;">Log in</button>
                                                    <div class="o_login_auth"/>
                                                </div>
                                            </div>
                                            <div class="justify-content-between mt-2 d-flex small">
                                                <a t-if="signup_enabled" t-attf-href="/web/signup?{{ keep_query() }}">
                                                    Don't have an account?
                                                </a>
                                                <a t-if="reset_password_enabled"
                                                   t-attf-href="/web/reset_password?{{ keep_query() }}">Reset Password
                                                </a>
                                            </div>
                                            <div class="col-12 text-center pt-2">
                                                <t t-if="debug">
                                                    <button type="submit"
                                                            name="redirect"
                                                            value="/web/become"
                                                            class="btn btn-link btn-sm">
                                                        Log in as superuser
                                                    </button>
                                                </t>
                                            </div>
                                            <input type="hidden" name="redirect"
                                                   t-att-value="redirect"/>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
