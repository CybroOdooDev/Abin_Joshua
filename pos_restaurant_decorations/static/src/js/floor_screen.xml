<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="pos_restaurant.FloorScreen" t-inherit-mode="extension">
        <xpath expr="//EditBar" position="attributes">
            <attribute name="addDecor.bind">addDecor</attribute>
            <attribute name="customizeTable.bind">customizeTable</attribute>
            <attribute name="rotateLeft.bind">rotateLeft</attribute>
            <attribute name="rotateRight.bind">rotateRight</attribute>
            <attribute name="bringToFront.bind">bringToFront</attribute>
            <attribute name="sendToBack.bind">sendToBack</attribute>
        </xpath>
        <xpath expr="//div[hasclass('floor-map')]" position="attributes">
            <attribute name="t-att-data-floor-plan-style">pos.floorPlanStyle</attribute>
        </xpath>
        <xpath expr="//div[@t-ref='map']/t[@t-foreach='activeTables']" position="attributes">
            <attribute name="t-key">(pos.floorPlanStyle || 'default') + '_' + table.id</attribute>
        </xpath>
    </t>
</templates>
