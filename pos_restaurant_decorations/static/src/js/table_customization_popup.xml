<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_restaurant_decorations.TableCustomizationPopup">
        <div class="popup table-customization-popup" style="max-width: 600px; width: 90vw;">
            <header class="modal-header bg-dark text-white p-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-sliders fs-4 text-info"></i>
                    <h4 class="modal-title m-0 fw-bold text-white"><t t-esc="modalTitle"/></h4>
                </div>
            </header>

            <main class="modal-body p-4 bg-white">
                <!-- Current Item Visual Banner -->
                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-4 border">
                    <div class="d-flex align-items-center justify-content-center bg-white rounded-3 border shadow-sm"
                         style="width: 72px; height: 72px; overflow: hidden; flex-shrink: 0; padding: 4px;">
                        <t t-if="state.imagePreview">
                            <img t-att-src="state.imagePreview" alt="Item Preview" style="max-width: 100%; max-height: 100%; object-fit: contain;"/>
                        </t>
                        <t t-else="">
                            <i class="fa fa-cutlery text-muted fs-2"></i>
                        </t>
                    </div>

                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                            <h5 class="m-0 fw-bold text-dark"><t t-esc="state.name || 'Floor Item'"/></h5>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><t t-esc="itemCategoryBadge"/></span>
                        </div>
                        <small class="text-muted d-block">
                            <t t-if="isDiningTable">Configure dining table identity, customer seats, and floor visibility.</t>
                            <t t-else="">Configure decorative floor item identity, scenery options, and floor visibility.</t>
                        </small>
                    </div>
                </div>

                <!-- Name & Seats Controls -->
                <div class="row g-3 mb-3">
                    <div t-attf-class="{{ state.is_decoration ? 'col-12' : 'col-8' }}">
                        <label class="form-label fw-bold"><t t-esc="nameLabelText"/></label>
                        <input type="text" class="form-control" t-model="state.name"/>
                    </div>
                    <t t-if="!state.is_decoration">
                        <div class="col-4">
                            <label class="form-label fw-bold">Customer Seats</label>
                            <input type="number" min="1" max="50" class="form-control" t-model.number="state.seats"/>
                        </div>
                    </t>
                </div>

                <!-- Toggles for Clean Display & Scenery -->
                <div class="p-3 bg-light rounded-3 border">
                    <span class="fw-bold text-dark d-block mb-2">Display &amp; Ordering Options</span>

                    <!-- Dynamic Name/Label Toggle -->
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="showLabelSwitch" t-model="state.show_label"/>
                        <label class="form-check-label" for="showLabelSwitch">
                            <t t-esc="showNameToggleText"/>
                        </label>
                    </div>

                    <!-- Show Seats Toggle (Only visible for dining tables with seating) -->
                    <t t-if="!state.is_decoration">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="showSeatsSwitch" t-model="state.show_seats"/>
                            <label class="form-check-label" for="showSeatsSwitch">
                                Show Seats Count badge on floor map
                            </label>
                        </div>
                    </t>

                    <!-- Scenery Mode Switch -->
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="isDecorSwitch"
                               t-att-checked="state.is_decoration"
                               t-on-change="onToggleIsDecoration"/>
                        <label class="form-check-label" for="isDecorSwitch">
                            <strong>Visual Scenery Mode (Non-orderable)</strong>
                        </label>
                    </div>
                    <small class="text-muted ps-4 d-block">
                        Enable for decorative items (flowerpots, barrels, fountains, dividers) so waitstaff won't accidentally open an order on them.
                    </small>
                </div>
            </main>

            <footer class="footer modal-footer p-3 bg-light border-top d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary px-4" t-on-click="cancel">
                    <t t-esc="props.cancelText"/>
                </button>
                <button type="button" class="btn btn-primary px-4 fw-bold" t-on-click="confirm">
                    <t t-esc="props.confirmText"/>
                </button>
            </footer>
        </div>
    </t>

</templates>
