<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit restaurant.table Form View -->
    <record id="view_restaurant_table_form_inherit_decorations" model="ir.ui.view">
        <field name="name">restaurant.table.form.inherit.decorations</field>
        <field name="model">restaurant.table</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_table_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="after">
                <group string="Decoration &amp; Customization">
                    <group>
                        <field name="table_type"/>
                        <field name="is_decoration"/>
                        <field name="decor_preset_id"/>
                        <field name="image_url"/>
                    </group>
                    <group>
                        <field name="show_label"/>
                        <field name="show_seats"/>
                        <field name="custom_image" widget="image" class="oe_avatar"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit restaurant.floor Form View to show decor details in table sub-tree -->
    <record id="view_restaurant_floor_form_inherit_decorations" model="ir.ui.view">
        <field name="name">restaurant.floor.form.inherit.decorations</field>
        <field name="model">restaurant.floor</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_floor_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='table_ids']/tree/field[@name='shape']" position="after">
                <field name="table_type" optional="show"/>
                <field name="is_decoration" optional="show"/>
                <field name="decor_preset_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
