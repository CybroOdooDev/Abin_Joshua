<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--DASHBOARD VIEW WITH NAVIGATION-BAR, INTERACTJS TEMPLATE-->
    <t t-name="owl.AdvancedDynamicDashboard" owl="1">
        <div class="container o_advanced_dynamic_dashboard" style="min-height:-webkit-fill-available;">
            <div class="navbar navbar-style border-bottom" role="navigation">
                <!-- Left Toolbar: Add Items, Edit/Save Layout, View Mode, Theme -->
                <div class="dashboard-toolbar-left">
                    <div class="dropdown">
                        <button class="btn btn-primary o_dropdown_title dropdown-toggle"
                                type="button" id="dropdownMenuButton"
                                data-bs-toggle="dropdown" data-toggle="dropdown"
                                aria-haspopup="true" aria-expanded="false">
                            <i class="fa fa-plus-circle me-1"/>
                            <span id="text_add">Add Items</span>
                        </button>
                        <div class="dropdown-menu dropdown-addblock"
                             aria-labelledby="dropdownMenuButton">
                            <a class="dropdown-item add_block"
                               data-type="tile"
                               t-on-click="(ev) => this.onClickAddItem(ev)">Tile</a>
                            <a class="dropdown-item add_block"
                               data-type="graph" data-chart_type="bar"
                               t-on-click="(ev) => this.onClickAddItem(ev)">Bar Chart</a>
                            <a class="dropdown-item add_block"
                               data-type="graph" data-chart_type="doughnut"
                               t-on-click="(ev) => this.onClickAddItem(ev)">Doughnut Chart</a>
                            <a class="dropdown-item add_block"
                               data-type="graph"
                               data-chart_type="line"
                               t-on-click="(ev) => this.onClickAddItem(ev)">Line Chart</a>
                            <a class="dropdown-item add_block"
                               data-type="graph" data-chart_type="pie"
                               t-on-click="(ev) => this.onClickAddItem(ev)">Pie Chart</a>
                            <a class="dropdown-item add_block"
                               data-type="graph"
                               data-chart_type="polarArea"
                               t-on-click="(ev) => this.onClickAddItem(ev)">Polar Area Chart</a>
                            <a class="dropdown-item add_block"
                               data-type="graph"
                               data-chart_type="radar"
                               t-on-click="(ev) => this.onClickAddItem(ev)">Radar Chart</a>
                        </div>
                    </div>

                    <div class="navbar-items layout-switch" id="edit-layout-label">
                        <button class="navbar-items btn-search_edit btn-align-items btn btn-primary"
                                type="button"
                                id="edit_layout"
                                t-on-click="(ev) => this.editLayout(ev)">Edit Layout</button>
                        <button class="navbar-items btn-search_edit btn btn-primary"
                                type="button"
                                id="save_layout"
                                t-on-click="(ev) => this.saveLayout(ev)">Save Layout</button>
                        <label for="view_mode"
                               class="view-mode-toggle"
                               t-on-mouseover="(ev) => this.showViewMode(ev)"
                               t-on-mouseout="(ev) => this.hideViewMode(ev)"
                               t-on-click="(ev) => this.changeViewMode(ev)">
                            <input type="checkbox" id="view_mode"/>
                            <span><i class="bi bi-moon-stars-fill view-mode-icon"/></span>
                        </label>
                        <span class="mode" mode="light">Dark mode</span>
                    </div>

                    <div class="o-dropdown dropdown theme">
                        <select class="form-select theme-select"
                                t-ref="this.ThemeSelector"
                                t-on-change="(ev) => this.onChangeTheme(ev)">
                            <option value="0">Select Theme</option>
                        </select>
                    </div>
                </div>

                <!-- Right Toolbar: Date Filters, Export Icons, Search -->
                <div class="dashboard-toolbar-right">
                    <!-- Date Inputs -->
                    <div class="date-inputs">
                        <div class="date-item">
                            <label for="start-date" class="date-label">Start Date:</label>
                            <input type="date" id="start-date" name="start-date"
                                   t-on-change="(ev) => this.dateFilter(ev)"/>
                        </div>
                        <div class="date-item">
                            <label for="end-date" class="date-label">End Date:</label>
                            <input type="date" id="end-date" name="end-date"
                                   t-on-change="(ev) => this.dateFilter(ev)"/>
                        </div>
                    </div>

                    <!-- Action Icons -->
                    <div class="dashboard-icons-group">
                        <div class="dashboard_pdf" t-on-click="(ev) => this.printPdf(ev)" title="Print PDF">
                            <i class="bi bi-filetype-pdf"/>
                        </div>
                        <div class="dashboard_mail" t-on-click="(ev) => this.sendMail(ev)" title="Send Mail">
                            <i class="bi bi-envelope-fill"/>
                        </div>
                    </div>

                    <!-- Search Bar -->
                    <div class="search-group">
                        <div class="navbar-items search-box">
                            <input class="form-control search-input-chart" type="text"
                                   placeholder="Search" t-on-change="(ev) => this.input_change(ev)"
                                   id="search-input-chart" aria-label="Search"/>
                            <span id="searchclear" t-on-click="(ev) => this.clearSearch(ev)" title="Clear">
                                <i class="fa fa-times search-clear"/>
                            </span>
                        </div>
                        <button class="btn btn-outline-success btn-search-submit"
                                t-on-click="(ev) => this.clickSearch(ev)"
                                type="button">Search
                        </button>
                    </div>
                </div>
            </div>
            <div class="all_items">
                <div class="items"/>
            </div>
                <!--CONTAINER FOR CONTENT GENERATION :TILE & CHART(FROM DynamicDashboardTile & DynamicDashboardChart-->
        </div>
    </t>
</templates>
