<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_kitchen_display_view_form" model="ir.ui.view">
        <field name="name">kitchen.display.view.form</field>
        <field name="model">kitchen.display</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="pos_ids" widget="many2many_tags"/>
                        <field name="product_pos_categ_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Stages">
                            <field name="stage_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="color" widget="color"/>
                                    <field name="alert_timer"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="kitchen_display_view_tree" model="ir.ui.view">
        <field name="name">kitchen.display.view.tree</field>
        <field name="model">kitchen.display</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="pos_ids" widget="many2many_tags"/>
                <field name="in_progress_count"/>
                <field name="avg_waiting_minutes"/>
            </tree>
        </field>
    </record>
    <record id="view_kitchen_display_kanban" model="ir.ui.view">
        <field name="name">kitchen.display.kanban</field>
        <field name="model">kitchen.display</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-menu">
                        <div class="container">
                            <div class="row">
                                <div class="col-4 o_kanban_card_manage_section o_kanban_manage_view">
                                    <div groups="point_of_sale.group_pos_manager">
                                        <a type="edit"
                                           class="oe_kanban_action oe_kanban_action_a">
                                            Configure
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">

                            <!-- Title -->
                            <strong>
                                <field name="name"/>
                            </strong>

                            <!-- Stages -->
                            <div class="mt-2 mb-2">
                                <field name="stage_ids" widget="many2many_tags"/>
                            </div>

                            <div class="container o_kanban_card_content">
                                <div class="row align-items-center">

                                    <!-- LEFT SIDE : BUTTON -->
                                    <div class="col-6">
                                        <button type="object"
                                                name="open_display"
                                                class="btn btn-primary w-100 py-2">
                                            Open Preparation Display
                                        </button>
                                    </div>

                                    <!-- RIGHT SIDE : STATS -->
                                    <div class="col-6">

                                        <div class="d-flex justify-content-between">
                                            <span>In progress</span>
                                            <span class="fw-bold">
                                                <field name="in_progress_count"/>
                                            </span>
                                        </div>

                                        <div class="d-flex justify-content-between mt-2">
                                            <span>Average time</span>
                                            <span class="fw-bold">
                                                <field name="avg_waiting_minutes"/>'
                                            </span>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_kitchen_display" model="ir.actions.act_window">
        <field name="name">Preparation Display</field>
        <field name="res_model">kitchen.display</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <menuitem
            id="menu_pos_kitchen_display"
            name="Preparation Display"
            parent="point_of_sale.menu_point_root"
            action="action_kitchen_display"
            sequence="40"
    />
</odoo>