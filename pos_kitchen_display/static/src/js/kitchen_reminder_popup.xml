<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="pos_kitchen_display.CategoryReminderPopup" owl="1">
        <div class="modal fade show d-block">
            <div class="modal-dialog">
                <div class="modal-content">
                    <!-- HEADER -->
                    <div class="modal-header">
                        <h4>Select Categories</h4>
                        <button type="button" class="btn-close"
                                t-on-click="props.close"/>
                    </div>
                    <!-- BODY -->
                    <div class="modal-body">
                        <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                            <div class="form-check">
                                <input type="checkbox"
                                       class="form-check-input"
                                       t-att-id="cat.id"
                                       t-on-change="toggleCategory.bind(this, cat)"/>
                                <label class="form-check-label" t-att-for="cat.id">
                                    <t t-esc="cat.name"/>
                                </label>
                            </div>
                        </t>
                    </div>
                    <!-- FOOTER -->
                    <div class="modal-footer">
                        <button class="btn btn-primary"
                                t-on-click="sendReminder">
                            Send
                        </button>
                        <button class="btn btn-secondary"
                                t-on-click="props.close">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>