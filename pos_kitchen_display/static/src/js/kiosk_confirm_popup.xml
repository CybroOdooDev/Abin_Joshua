<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="pos_self_order.KioskConfirmPopup">
        <!-- Overlay -->
        <div style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; display:flex; flex-direction:column;">

            <!-- Banner at top -->
            <div class="bg-warning text-dark text-center w-100 py-4"
                 style="font-size:2rem; font-weight:bold; flex-shrink:0;">
                ⚠ <t t-esc="props.title"/>
            </div>

            <!-- Centered card below the banner -->
            <div style="flex:1; display:flex; align-items:center; justify-content:center;">
                <div class="bg-white rounded shadow p-4 text-center" style="max-width:400px; width:90%;">
                    <p style="font-size:1.2rem;">
                        Please make sure your order is correct before confirming.
                    </p>
                    <div class="mt-3 d-flex justify-content-center gap-3">
                        <button class="btn btn-success btn-lg" t-on-click="onConfirm">
                            ✓ Confirm
                        </button>
                        <button class="btn btn-danger btn-lg" t-on-click="onCancel">
                            ✗ Cancel
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </t>
</templates>