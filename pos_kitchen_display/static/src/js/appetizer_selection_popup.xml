<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_kitchen_display.AppetizerSelectionPopup">
        <div class="popup appetizer-selection-popup">
            <div class="modal-header">
                <h4 class="modal-title">
                    <i class="fa fa-cutlery me-2"/>
                    <t t-esc="props.title"/>
                    <t t-if="props.tableName">
                        <span class="text-muted fw-normal fs-6 ms-1">
                            (<t t-esc="props.tableName"/><t t-if="props.dinersCount"> - <t t-esc="props.dinersCount"/> Diners</t>)
                        </span>
                    </t>
                </h4>
            </div>

            <div class="modal-body">
                <p class="text-muted mb-3 small">
                    Choose an appetizer for the table. The quantity defaults to the number of diners.
                </p>

                <div class="appetizer-product-list mb-3 d-flex flex-wrap gap-2 justify-content-center" style="max-height: 240px; overflow-y: auto;">
                    <t t-foreach="props.products" t-as="product" t-key="product.id">
                        <div class="appetizer-product-card btn position-relative d-flex flex-column align-items-center justify-content-center p-3 border rounded shadow-sm"
                             t-att-class="state.selectedProductId === product.id ? 'btn-primary text-white border-primary' : 'btn-light text-dark border-secondary-subtle'"
                             style="min-width: 130px; min-height: 85px; cursor: pointer; flex: 1 1 calc(33% - 10px);"
                             t-on-click="() => this.selectProduct(product.id)">
                            <t t-if="state.selectedProductId === product.id">
                                <span class="position-absolute top-0 end-0 m-1 badge bg-white text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 22px; height: 22px;">
                                    <i class="fa fa-check"/>
                                </span>
                            </t>
                            <div class="fw-bold fs-6 text-center text-truncate w-100" t-att-title="product.display_name">
                                <t t-esc="product.display_name"/>
                            </div>
                            <div class="small mt-1 opacity-75">
                                <t t-esc="env.utils.formatCurrency(product.lst_price)"/>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Quantity Selector -->
                <div class="d-flex align-items-center justify-content-center gap-3 py-3 border-top bg-light rounded mt-2">
                    <span class="text-dark fw-bold small">Quantity:</span>
                    <button class="btn btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center"
                            style="width: 36px; height: 36px;"
                            t-on-click="() => this.updateQuantity(-1)">
                        <i class="fa fa-minus"/>
                    </button>
                    <input type="number"
                           class="form-control text-center fw-bold fs-5 bg-white border"
                           style="width: 80px; height: 38px;"
                           min="1"
                           t-att-value="state.quantity"
                           t-on-input="onQuantityChange"
                           t-on-change="onQuantityChange"/>
                    <button class="btn btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center"
                            style="width: 36px; height: 36px;"
                            t-on-click="() => this.updateQuantity(1)">
                        <i class="fa fa-plus"/>
                    </button>
                </div>
            </div>

            <div class="footer modal-footer d-flex justify-content-between">
                <button class="button cancel btn btn-secondary px-4" t-on-click="cancel">
                    <t t-esc="props.cancelText"/>
                </button>
                <button class="button confirm btn btn-primary px-4 fw-bold"
                        t-att-disabled="!state.selectedProductId"
                        t-on-click="confirm">
                    <t t-esc="props.confirmText"/>
                </button>
            </div>
        </div>
    </t>
</templates>
