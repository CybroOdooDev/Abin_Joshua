<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//CogMenu" position="after">
            <button t-att-disabled="!this.state?.undo?.length" class="btn btn-secondary ms-2" t-on-click="this.undo" title="Undo" aria-label="Undo">
                <i class="oi oi-fw" data-icon="undo"/>
            </button>
            <button t-att-disabled="!this.state?.redo?.length" class="btn btn-secondary ms-1" t-on-click="this.redo" title="Redo" aria-label="Redo">
                <i class="oi oi-fw" data-icon="redo"/>
            </button>
        </xpath>
    </t>
</templates>