<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tools_undo_redo" model="ir.module.category">
        <field name="name">Undo and Redo</field>
        <field name="description">Access rights for Undo and Redo operations.</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_undo_redo" model="res.groups.privilege">
        <field name="name">Undo and Redo</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_tools_undo_redo"/>
    </record>

    <record id="group_undo_redo_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_undo_redo"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>


