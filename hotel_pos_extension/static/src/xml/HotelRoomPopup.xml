<?xml version="1.0" encoding="utf-8"?>
<!-- Popup for selecting a room booking and viewing its details -->
<templates id="template" xml:space="preserve">
    <t t-name="hotel_pos_extension.HotelRoomPopup">
        <Dialog title="this.props.title" size="'md'">
            <div class="row">
                <span class="label">Room No</span>
                <select class="form-control" t-on-change="(ev) => this.onBookingChange(ev)">
                    <t t-foreach="this.props.bookings" t-as="booking" t-key="booking.id">
                        <option t-att-value="booking.id">
                            <t t-out="booking.name"/>
                        </option>
                    </t>
                </select>
            </div>
            <div class="row mt-2">
                <span class="label">Booking No</span>
                <input type="text" class="form-control" t-att-value="this.state.selectedBooking ? this.state.selectedBooking.name : ''" readonly="1"/>
            </div>
            <div class="row mt-2">
                <span class="label">Booking Customer</span>
                <input type="text" class="form-control" t-att-value="this.state.selectedBooking and this.state.selectedBooking.partner_id ? this.state.selectedBooking.partner_id[1] : ''" readonly="1"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="() => this.cancel()">Close</button>
                <button class="btn btn-primary" t-on-click="() => this.confirm()">Confirm</button>
            </t>
        </Dialog>
    </t>
</templates>
