<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sales_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 11px; color: #1e293b; padding: 10px 15px;">
                    
                    <!-- Global Table Styles for Crisp Borders & Explicit Contrast in wkhtmltopdf -->
                    <style>
                        .report-table {
                            width: 100%;
                            border-collapse: collapse !important;
                            margin-bottom: 0;
                        }
                        .report-table th, 
                        .report-table td {
                            border: 1px solid #94a3b8 !important;
                            vertical-align: middle;
                            padding: 4px 6px !important;
                            line-height: 1.25;
                        }
                        .report-table thead th {
                            font-weight: 700;
                        }
                        .report-table thead tr.bg-header-main th {
                            background-color: #e2e8f0 !important;
                            color: #0f172a !important;
                        }
                        .report-table thead tr.bg-header-sub th {
                            background-color: #f1f5f9 !important;
                            color: #334155 !important;
                            font-weight: 600;
                            font-size: 9px !important;
                        }
                        .report-table tbody tr.row-combo-parent td {
                            background-color: #f8fafc !important;
                            font-weight: 600;
                        }
                        .report-table tbody tr.row-total td {
                            background-color: #f1f5f9 !important;
                            font-weight: 700;
                        }
                    </style>
                    
                    <!-- 1. Header: Company Info (Left) & Report Title (Right) -->
                    <div class="row pb-2 mb-2 border-bottom border-dark align-items-center">
                        <div class="col-7">
                            <h4 class="fw-bold mb-0 text-uppercase" style="letter-spacing: -0.3px; color: #0f172a;" t-esc="report['company']['name']"/>
                            <div class="text-muted" style="font-size: 10px; line-height: 1.3;">
                                <div t-if="report['company']['vat']">
                                    <span t-esc="report['labels']['nif_cif_vat']"/>: <strong t-esc="report['company']['vat']"/>
                                </div>
                                <div t-if="report['company']['street']" t-esc="report['company']['street']"/>
                                <div t-if="report['company']['city_zip']" t-esc="report['company']['city_zip']"/>
                                <div t-if="report['company']['phone']">
                                    <span t-esc="report['labels']['tel']"/>: <span t-esc="report['company']['phone']"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-5 text-end">
                            <div class="fw-bold fs-5 text-uppercase" style="letter-spacing: 0.5px; color: #0f172a;" t-esc="report['labels']['pos_sales_report']"/>
                            <div class="text-muted fw-semibold" style="font-size: 10px;" t-esc="report['labels']['customizable_combos_taxes']"/>
                            <span class="badge bg-dark px-2 py-1 mt-1 text-uppercase" style="font-size: 9px;" t-esc="report['metadata']['attribution_label']"/>
                        </div>
                    </div>

                    <!-- 2. Metadata Strip -->
                    <div class="row p-2 mb-3 rounded" style="background-color: #f8fafc; border: 1px solid #e2e8f0; font-size: 10px;">
                        <div class="col-6">
                            <div class="mb-1"><strong><span t-esc="report['labels']['period']"/>:</strong> <span t-esc="report['metadata']['date_from_str']"/> - <span t-esc="report['metadata']['date_to_str']"/></div>
                            <div><strong><span t-esc="report['labels']['terminals']"/>:</strong> <span t-esc="report['metadata']['configs']"/></div>
                        </div>
                        <div class="col-6 text-end">
                            <div class="mb-1"><strong><span t-esc="report['metadata']['sessions_label']"/>:</strong> <span t-esc="report['metadata']['sessions']"/></div>
                            <div><strong><span t-esc="report['labels']['printed']"/>:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M:%S')"/></div>
                        </div>
                    </div>

                    <!-- 3. KPI Summary Cards (Dynamic Equal-Height Synchronization) -->
                    <div class="mb-3" style="page-break-inside: avoid; break-inside: avoid;">
                        <table style="width: 100%; border-collapse: separate; border-spacing: 8px 0; table-layout: fixed;">
                            <tr>
                                <td style="width: 25%; vertical-align: middle; padding: 8px 6px; background-color: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; text-align: center;">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 9px; line-height: 1.2; margin-bottom: 4px;" t-esc="report['labels']['net_sales']"/>
                                    <div class="fs-6 fw-bold text-dark" t-esc="report['kpis']['total_sales_excl_vat']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                </td>
                                <td style="width: 25%; vertical-align: middle; padding: 8px 6px; background-color: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; text-align: center;">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 9px; line-height: 1.2; margin-bottom: 4px;" t-esc="report['labels']['total_vat']"/>
                                    <div class="fs-6 fw-bold text-danger" t-esc="report['kpis']['total_vat_amount']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                </td>
                                <td style="width: 25%; vertical-align: middle; padding: 8px 6px; background-color: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; text-align: center;">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 9px; line-height: 1.2; margin-bottom: 4px;" t-esc="report['labels']['gross_sales']"/>
                                    <div class="fs-6 fw-bold text-primary" t-esc="report['kpis']['total_sales_incl_vat']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                </td>
                                <td style="width: 25%; vertical-align: middle; padding: 8px 6px; background-color: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; text-align: center;">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 9px; line-height: 1.2; margin-bottom: 4px;" t-esc="report['labels']['total_orders']"/>
                                    <div class="fs-6 fw-bold text-dark" t-esc="report['kpis']['total_orders']"/>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- 4. Multi-Rate VAT Breakdown Table -->
                    <div class="mb-3">
                        <div class="fw-bold text-uppercase border-bottom pb-1 mb-2" style="font-size: 11px; color: #0f172a;">
                            <i class="fa fa-percent me-1"/> <span t-esc="report['labels']['vat_breakdown']"/>
                        </div>
                        <table class="table table-sm table-bordered report-table mb-0" style="font-size: 10px;">
                            <thead>
                                <tr class="bg-header-main">
                                    <th class="text-start" style="width: 28%; color: #0f172a;" t-esc="report['labels']['tax_rule']"/>
                                    <th class="text-end" style="width: 12%; color: #0f172a;" t-esc="report['labels']['tax_rate']"/>
                                    <th class="text-end" style="width: 20%; color: #0f172a;" t-esc="report['labels']['base_amount']"/>
                                    <th class="text-end" style="width: 18%; color: #0f172a;" t-esc="report['labels']['vat_amount']"/>
                                    <th class="text-end" style="width: 22%; color: #0f172a;" t-esc="report['labels']['total_amount']"/>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="report['taxes']" t-as="tax">
                                    <td><strong t-esc="tax['name']"/></td>
                                    <td class="text-end"><span t-esc="'%.1f' % tax['rate'] if tax['rate'] % 1 else '%.0f' % tax['rate']"/>%</td>
                                    <td class="text-end" t-esc="tax['base']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                    <td class="text-end text-danger" t-esc="tax['tax']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                    <td class="text-end fw-bold" t-esc="tax['gross']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                </tr>
                                <tr class="row-total">
                                    <td colspan="2" class="text-uppercase" t-esc="report['labels']['total_taxes']"/>
                                    <td class="text-end" t-esc="report['kpis']['total_sales_excl_vat']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                    <td class="text-end text-danger" t-esc="report['kpis']['total_vat_amount']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                    <td class="text-end text-primary" t-esc="report['kpis']['total_sales_incl_vat']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- 5. Option A: Sales by Category with Hierarchical Combo Breakdown -->
                    <div class="mb-3">
                        <div class="fw-bold text-uppercase border-bottom pb-1 mb-2" style="font-size: 11px; color: #0f172a;">
                            <i class="fa fa-cutlery me-1"/> <span t-esc="report['labels']['sales_category_breakdown']"/>
                        </div>

                        <t t-foreach="report['categories']" t-as="cat">
                            <div class="category-block mb-3" style="page-break-inside: avoid; break-inside: avoid;">
                                <table class="table table-sm table-bordered report-table mb-0" style="font-size: 10px;">
                                    <thead>
                                        <tr class="bg-header-main">
                                            <th colspan="2" class="text-uppercase fw-bold">
                                                <i class="fa fa-folder-open me-1"/> <span t-esc="cat['name']"/>
                                            </th>
                                            <th class="text-end fw-bold" style="width: 8%;"><span t-esc="('%.0f' % cat['qty']) if (cat['qty'] % 1 == 0) else ('%.2f' % cat['qty'])"/> <span t-esc="report['labels']['units']"/></th>
                                            <th class="text-end" style="width: 12%;"></th>
                                            <th class="text-end fw-bold" style="width: 13%;" t-esc="cat['subtotal']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                            <th class="text-end fw-bold text-danger" style="width: 12%;" t-esc="cat['tax']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                            <th class="text-end fw-bold text-primary" style="width: 15%;" t-esc="cat['gross']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                        </tr>
                                        <tr class="bg-header-sub">
                                            <th style="width: 30%;" t-esc="report['labels']['product_component']"/>
                                            <th style="width: 10%;" t-esc="report['labels']['ref']"/>
                                            <th class="text-end" style="width: 8%;" t-esc="report['labels']['qty']"/>
                                            <th class="text-end" style="width: 12%;" t-esc="report['labels']['unit_price']"/>
                                            <th class="text-end" style="width: 13%;" t-esc="report['labels']['net_excl_vat']"/>
                                            <th class="text-end" style="width: 12%;" t-esc="report['labels']['vat']"/>
                                            <th class="text-end" style="width: 15%;" t-esc="report['labels']['gross_incl_vat']"/>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- A. Combos Section -->
                                        <t t-foreach="cat['combos']" t-as="combo">
                                            <!-- Combo Parent Row -->
                                            <tr class="row-combo-parent">
                                                <td>
                                                    <span class="badge bg-secondary me-1" style="font-size: 8px;" t-esc="report['labels']['combo']"/>
                                                    <span t-esc="combo['product_name']"/>
                                                </td>
                                                <td><span class="text-muted" t-esc="combo['code']"/></td>
                                                <td class="text-end"><strong t-esc="('%.0f' % combo['qty']) if (combo['qty'] % 1 == 0) else ('%.2f' % combo['qty'])"/></td>
                                                <td class="text-end" t-esc="combo['price_unit']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                                <td class="text-end" t-esc="combo['subtotal']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                                <td class="text-end text-danger" t-esc="combo['tax']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                                <td class="text-end" t-esc="combo['gross']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                            </tr>
                                            <!-- Indented Nested Sub-Products -->
                                            <tr t-foreach="combo['components']" t-as="comp" style="color: #475569; font-size: 9.5px; background-color: #ffffff;">
                                                <td style="padding-left: 20px;">
                                                    <span class="text-muted">↳</span> <span t-esc="comp['product_name']"/>
                                                </td>
                                                <td><span class="text-muted" t-esc="comp['code']"/></td>
                                                <td class="text-end"><span t-esc="('%.0f' % comp['qty']) if (comp['qty'] % 1 == 0) else ('%.2f' % comp['qty'])"/></td>
                                                <td class="text-end">
                                                    <t t-if="comp['extra_price'] > 0">
                                                        <span class="badge bg-light text-dark border" style="font-size: 8px;">+<span t-esc="comp['extra_price']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/></span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="text-muted">-</span>
                                                    </t>
                                                </td>
                                                <td class="text-end" t-esc="comp['subtotal']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                                <td class="text-end text-danger" t-esc="comp['tax']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                                <td class="text-end" t-esc="comp['gross']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                            </tr>
                                        </t>

                                        <!-- B. Standalone Products Section -->
                                        <tr t-foreach="cat['standalone']" t-as="prod">
                                            <td>
                                                <span t-esc="prod['product_name']"/>
                                                <t t-if="prod['in_combo_qty'] > 0">
                                                    <span class="badge bg-info text-dark ms-1" style="font-size: 8px;">+<span t-esc="('%.0f' % prod['in_combo_qty']) if (prod['in_combo_qty'] % 1 == 0) else ('%.2f' % prod['in_combo_qty'])"/> <span t-esc="report['labels']['in_combos']"/></span>
                                                </t>
                                            </td>
                                            <td><span class="text-muted" t-esc="prod['code']"/></td>
                                            <td class="text-end"><span t-esc="('%.0f' % prod['qty']) if (prod['qty'] % 1 == 0) else ('%.2f' % prod['qty'])"/></td>
                                            <td class="text-end" t-esc="prod['price_unit']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                            <td class="text-end" t-esc="prod['subtotal']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                            <td class="text-end text-danger" t-esc="prod['tax']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                            <td class="text-end fw-semibold" t-esc="prod['gross']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </div>

                    <!-- 6. Consolidated Product Matrix (Dual Count: Standalone + In-Combo) -->
                    <div class="mb-3" style="break-inside: avoid;">
                        <div class="fw-bold text-uppercase border-bottom pb-1 mb-2" style="font-size: 11px; color: #0f172a;">
                            <i class="fa fa-cubes me-1"/> <span t-esc="report['labels']['consumption_matrix']"/>
                        </div>
                        <p class="text-muted mb-1" style="font-size: 9px;" t-esc="report['labels']['consumption_subtitle']"/>
                        <table class="table table-sm table-bordered report-table mb-0" style="font-size: 9.5px;">
                            <thead>
                                <tr class="bg-header-sub">
                                    <th style="width: 26%;" t-esc="report['labels']['product']"/>
                                    <th style="width: 14%;" t-esc="report['labels']['category']"/>
                                    <th class="text-end" style="width: 10%;" t-esc="report['labels']['standalone_qty']"/>
                                    <th class="text-end" style="width: 10%;" t-esc="report['labels']['in_combo_qty']"/>
                                    <th class="text-end fw-bold" style="width: 10%;" t-esc="report['labels']['total_units']"/>
                                    <th class="text-end" style="width: 14%;" t-esc="report['labels']['net_excl_vat']"/>
                                    <th class="text-end" style="width: 16%;" t-esc="report['labels']['gross_incl_vat']"/>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="report['consumption']" t-as="item">
                                    <td><strong t-esc="item['product_name']"/></td>
                                    <td><span class="text-muted" t-esc="item['category_name']"/></td>
                                    <td class="text-end"><span t-esc="('%.0f' % item['standalone_qty']) if (item['standalone_qty'] % 1 == 0) else ('%.2f' % item['standalone_qty'])"/></td>
                                    <td class="text-end"><span t-esc="('%.0f' % item['combo_qty']) if (item['combo_qty'] % 1 == 0) else ('%.2f' % item['combo_qty'])"/></td>
                                    <td class="text-end fw-bold"><span t-esc="('%.0f' % item['total_qty']) if (item['total_qty'] % 1 == 0) else ('%.2f' % item['total_qty'])"/></td>
                                    <td class="text-end" t-esc="item['subtotal']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                    <td class="text-end" t-esc="item['gross']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- 7. Payments Summary -->
                    <div t-if="report['payments']" class="row mb-3" style="break-inside: avoid;">
                        <div class="col-6">
                            <div class="fw-bold text-uppercase border-bottom pb-1 mb-2" style="font-size: 11px; color: #0f172a;">
                                <i class="fa fa-credit-card me-1"/> <span t-esc="report['labels']['payment_methods']"/>
                            </div>
                            <table class="table table-sm table-bordered report-table mb-0" style="font-size: 10px;">
                                <thead>
                                    <tr class="bg-header-sub">
                                        <th style="width: 60%;" t-esc="report['labels']['method']"/>
                                        <th class="text-end" style="width: 40%;" t-esc="report['labels']['total_paid']"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="report['payments']" t-as="p">
                                        <td t-esc="p['name']"/>
                                        <td class="text-end fw-bold" t-esc="p['total']" t-options="{'widget': 'monetary', 'display_currency': report['metadata']['currency']}"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>

