<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Wizard view to upload scanned bill files -->
    <record id="digitize_bill_view_form" model="ir.ui.view">
        <field name="name">digitize.bill.view.form</field>
        <field name="model">digitize.bill</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <p class="text-center fst-italic">Upload an image or PDF bill document</p>
                    <group>
                        <group>
                            <field name="bill" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_add_document"
                            class="btn-primary"
                            string="Add"
                            type="object"
                            help="Extract text from the document and create a vendor bill"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!-- Window action for the Digitize Bill wizard -->
    <record id="digitize_bill_action" model="ir.actions.act_window">
        <field name="name">Digitize Bill</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">digitize.bill</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="digitize_bill_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
