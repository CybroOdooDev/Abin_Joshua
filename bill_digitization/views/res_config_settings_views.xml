<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit Accounting settings to add the Bill Digitization option -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bill.digitization</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="inside">
                <setting id="digitize_bill"
                         help="Digitize vendor bills from scanned documents (.pdf, .jpg, .jpeg, or .png) using OCR">
                    <field name="digitize_bill"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
